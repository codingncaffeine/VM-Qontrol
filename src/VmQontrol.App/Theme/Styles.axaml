<!-- Named styles over the tokens. A view picks a class (h1, muted, primary, card) and never sets a colour itself. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource QBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource QText}" />
    <Setter Property="FontSize" Value="{DynamicResource QFontBody}" />
  </Style>
  <Style Selector="TextBlock.hero">
    <Setter Property="FontSize" Value="{DynamicResource QFontHero}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource QFontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource QFontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource QTextMuted}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource QTextMuted}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource QSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadiusLarge}" />
    <Setter Property="Padding" Value="{DynamicResource QCardPadding}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource QAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource QOnAccent}" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadius}" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource QAccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource QOnAccent}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource QSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadius}" />
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="{DynamicResource QRadius}" />
    <Setter Property="Background" Value="{DynamicResource QSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
  </Style>
  <!-- Tabs: the page's sections, sized to the type scale (Fluent's default headers are display-sized). -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="2,0,18,0" />
  </Style>

  <!-- Choice cards: a radio button drawn as a card (the wizard's big questions). -->
  <Style Selector="RadioButton.choice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Card" Background="{DynamicResource QSurface}" BorderBrush="{DynamicResource QBorder}" BorderThickness="2"
                CornerRadius="{DynamicResource QRadiusLarge}" Padding="16,14">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.choice:pointerover /template/ Border#Card">
    <Setter Property="BorderBrush" Value="{DynamicResource QTextMuted}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ Border#Card">
    <Setter Property="BorderBrush" Value="{DynamicResource QAccent}" />
    <Setter Property="Background" Value="{DynamicResource QAccentSoft}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource QWarning}" />
  </Style>
  <Style Selector="TextBlock.done">
    <Setter Property="Foreground" Value="{DynamicResource QText}" />
  </Style>
  <Style Selector="TextBlock.current">
    <Setter Property="Foreground" Value="{DynamicResource QAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Icons -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground, FallbackValue={StaticResource QText}}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Path.icon.favourite">
    <Setter Property="Stroke" Value="{DynamicResource QWarning}" />
    <Setter Property="Fill" Value="{DynamicResource QWarning}" />
  </Style>
  <Style Selector="Path.iconfill">
    <Setter Property="Fill" Value="{Binding $parent[ContentPresenter].Foreground, FallbackValue={StaticResource QText}}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- Toolbar buttons: icon and words, quiet until hovered. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadius}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource QSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QAccent}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource QDanger}" />
  </Style>
  <Style Selector="Button.primary.danger">
    <Setter Property="Background" Value="{DynamicResource QDanger}" />
    <Setter Property="Foreground" Value="{DynamicResource QOnAccent}" />
  </Style>
  <Style Selector="Button.icononly">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadiusSmall}" />
  </Style>

  <!-- Guest badge -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource QBadgeOther}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.badge.windows"><Setter Property="Background" Value="{DynamicResource QBadgeWindows}" /></Style>
  <Style Selector="Border.badge.linux"><Setter Property="Background" Value="{DynamicResource QBadgeLinux}" /></Style>
  <Style Selector="Border.badge.apple"><Setter Property="Background" Value="{DynamicResource QBadgeApple}" /></Style>
  <Style Selector="Border.badge.bsd"><Setter Property="Background" Value="{DynamicResource QBadgeBsd}" /></Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- State dot and pill -->
  <Style Selector="Ellipse.state">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource QTextMuted}" />
  </Style>
  <Style Selector="Ellipse.state.running"><Setter Property="Fill" Value="{DynamicResource QSuccess}" /></Style>
  <Style Selector="Ellipse.state.paused"><Setter Property="Fill" Value="{DynamicResource QWarning}" /></Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource QSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource QFontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource QSuccess}" /></Style>
  <Style Selector="Border.pill.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource QWarning}" /></Style>
  <Style Selector="Border.pill.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource QDanger}" /></Style>
  <Style Selector="Border.pill.muted TextBlock"><Setter Property="Foreground" Value="{DynamicResource QTextMuted}" /></Style>

  <!-- Cards with a status edge -->
  <Style Selector="Border.card.problem">
    <Setter Property="BorderBrush" Value="{DynamicResource QWarning}" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource QBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.code TextBlock">
    <Setter Property="FontFamily" Value="monospace" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Console lines: plain rows, no selection highlight, tight spacing. -->
  <Style Selector="ListBox.console ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="18" />
  </Style>
  <Style Selector="ListBox.console ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.console ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Sidebar list -->
  <Style Selector="ListBox.library">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.library ListBoxItem">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QRadius}" />
  </Style>
  <Style Selector="ListBox.library ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource QAccentSoft}" />
  </Style>
  <Style Selector="ListBox.library ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource QSurfaceRaised}" />
  </Style>
</Styles>
