<!-- VM Qontrol's icons: simple geometry on a 24-unit grid, drawn for this project (no icon font, no vendor marks).
     Stroke icons use Path.icon; filled ones Path.iconfill. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M7,5 L10,5 L10,19 L7,19 Z M14,5 L17,5 L17,19 L14,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSuspend">M14.5,4 A8,8 0 1 0 20,14.5 A6.5,6.5 0 0 1 14.5,4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M6,6 L18,6 L18,18 L6,18 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPower">M12,3 L12,11 M7.1,6.2 A7.5,7.5 0 1 0 16.9,6.2</StreamGeometry>
  <StreamGeometry x:Key="IconReset">M4.5,12 A7.5,7.5 0 1 0 7,6.4 M4,3.5 L4,8 L8.5,8</StreamGeometry>
  <StreamGeometry x:Key="IconScreen">M3,5 L21,5 L21,16 L3,16 Z M9,20 L15,20 M12,16 L12,20</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M8,8 L19,8 L19,20 L8,20 Z M5,16 L5,4 L15,4</StreamGeometry>
  <StreamGeometry x:Key="IconStar">M12,3 L14.6,8.8 L21,9.3 L16.1,13.4 L17.6,19.7 L12,16.3 L6.4,19.7 L7.9,13.4 L3,9.3 L9.4,8.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M19.5,12 A7.5,7.5 0 1 1 17,6.4 M20,3.5 L20,8 L15.5,8</StreamGeometry>
  <StreamGeometry x:Key="IconHome">M4,11 L12,4 L20,11 M6,9.5 L6,20 L18,20 L18,9.5</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,16.5 L12,17.5</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M4,7 L14,7 M18,7 L20,7 M16,4.5 A2.5,2.5 0 1 1 16,9.5 A2.5,2.5 0 1 1 16,4.5 M4,17 L6,17 M10,17 L20,17 M8,14.5 A2.5,2.5 0 1 1 8,19.5 A2.5,2.5 0 1 1 8,14.5</StreamGeometry>
  <StreamGeometry x:Key="IconUsb">M12,2 L12,18 M12,2 L9.5,5 M12,2 L14.5,5 M12,12 L7,9 L7,7 M12,14 L17,11 L17,9 M10.5,18 L13.5,18 L13.5,21 L10.5,21 Z M6,5.5 L8,5.5 L8,7.5 L6,7.5 Z M16.2,7.2 A0.9,0.9 0 1 1 17.8,7.2 A0.9,0.9 0 1 1 16.2,7.2</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17 L19,7</StreamGeometry>
</ResourceDictionary>
