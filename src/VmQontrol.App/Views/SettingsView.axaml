<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VmQontrol.App.ViewModels"
             xmlns:m="using:VmQontrol.Core.Machines"
             x:Class="VmQontrol.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!--
    Every section has the same shape: its title with when changes apply, then groups (cards) of rows. A row is the
    setting's name and one or two lines of what it does on the left, its control on the right, so every control in a
    section lines up on one edge.
  -->
  <UserControl.Styles>
    <Style Selector="Border.group">
      <Setter Property="Background" Value="{DynamicResource QSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource QRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.row.first">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.row > Grid">
      <Setter Property="ColumnSpacing" Value="28" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="Foreground" Value="{DynamicResource QTextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{DynamicResource QFontSmall}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.grouptitle">
      <Setter Property="FontSize" Value="{DynamicResource QFontSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource QTextMuted}" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Margin" Value="2,6,0,-4" />
    </Style>
    <Style Selector="StackPanel.section">
      <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="Border.badge-next">
      <Setter Property="Background" Value="{DynamicResource QSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge-next TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource QFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource QTextMuted}" />
    </Style>
    <Style Selector="Border.badge-now">
      <Setter Property="Background" Value="{DynamicResource QAccentSoft}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge-now TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource QFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource QAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.row ComboBox">
      <Setter Property="Width" Value="300" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row NumericUpDown">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <!-- The switch keeps room for a label it no longer shows; pull it to the edge the other controls end on. -->
      <Setter Property="Margin" Value="0,0,-11,0" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource QAccentSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tile > Path">
      <Setter Property="Stroke" Value="{DynamicResource QAccent}" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="ListBox#Sections ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="{DynamicResource QPagePadding}">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
      <TextBlock Text="{Binding Title}" Classes="hero" />
      <TextBlock Text="{Binding TimingNote}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Button Classes="secondary" Content="Close" Command="{Binding CloseCommand}" />
        <TextBlock x:Name="SaveNote" Grid.Column="1" Text="{Binding SaveNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="Save" Grid.Column="2" Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

    <ListBox x:Name="Sections" AutomationProperties.Name="Settings sections" DockPanel.Dock="Left" Width="220" Classes="library" ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" Margin="0,0,28,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SettingsSection">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform" Opacity="0.85" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Padding="0,0,14,0">
      <!-- One width for every page: the column grows with the window up to 820, and stays on the left. -->
      <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="820" />
        <ColumnDefinition Width="0.01*" />
      </Grid.ColumnDefinitions>
      <Panel>

        <!-- General -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=general}">
          <TextBlock Text="General" Classes="h1" />
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Name" Classes="label" />
                    <TextBlock Text="Shown in the library and the viewer window's title." Classes="help" />
                  </StackPanel>
                  <TextBox x:Name="MachineName" Grid.Column="1" Text="{Binding Name}" Width="300" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Operating system" Classes="label" />
                    <TextBlock Text="Decides the virtual hardware (processor features, disk and network adapters). Change it only if the machine was made with the wrong one." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding GuestChoices}" SelectedItem="{Binding Guest}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <StackPanel Spacing="8">
                  <StackPanel>
                    <TextBlock Text="Notes" Classes="label" />
                    <TextBlock Text="Anything you want to remember about this machine; shown on its summary." Classes="help" />
                  </StackPanel>
                  <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Memory -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=memory}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Memory" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Use the recommended amount" Classes="label" />
                    <TextBlock Text="{Binding MemoryNote}" Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding MemoryAuto}" />
                </Grid>
              </Border>
              <Border Classes="row" IsEnabled="{Binding !MemoryAuto}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Memory" Classes="label" />
                    <TextBlock Text="Giving more than half of this computer's memory slows the computer itself." Classes="help" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <NumericUpDown x:Name="MemoryGb" Value="{Binding MemoryGb}" Minimum="0.25" Maximum="{Binding HostMemoryGb}" Increment="1" FormatString="0.##" Width="150" />
                    <TextBlock Text="GB" VerticalAlignment="Center" Classes="muted" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <!-- While it runs: the balloon gives memory back to this computer, and takes it again up to the size it started with. -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding LiveMemoryShown}" Margin="0,8,0,0">
            <TextBlock Text="WHILE IT RUNS" Classes="grouptitle" />
            <Border Grid.Column="1" Classes="badge-now"><TextBlock Text="Applies now" /></Border>
          </Grid>
          <Border x:Name="LiveMemory" Classes="group" IsVisible="{Binding LiveMemoryShown}">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Memory it may use now" Classes="label" />
                    <TextBlock Text="Lower it to give memory back to this computer without shutting down; raise it again up to the amount the machine started with. Windows needs the guest tools for this." Classes="help" />
                    <TextBlock x:Name="LiveMemoryStatus" Text="{Binding LiveMemoryStatus}" Classes="help" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <NumericUpDown x:Name="LiveMemoryGb" Value="{Binding LiveMemoryGb}" Minimum="0.25" Maximum="{Binding LiveMemoryMaxGb}" Increment="0.5" FormatString="0.##" Width="150" />
                    <TextBlock Text="GB" VerticalAlignment="Center" Classes="muted" />
                    <Button x:Name="ApplyLiveMemory" Classes="tool" Content="Apply now" Command="{Binding ApplyLiveMemoryCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Processors -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=processors}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Processors" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Use the recommended number" Classes="label" />
                    <TextBlock Text="{Binding CoresNote}" Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding CoresAuto}" />
                </Grid>
              </Border>
              <Border Classes="row" IsEnabled="{Binding !CoresAuto}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Processors" Classes="label" />
                    <TextBlock Text="Processor cores the machine sees." Classes="help" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="1" Value="{Binding Cores}" Minimum="1" Maximum="{Binding HostCores}" Increment="1" FormatString="0" Width="150" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Add processors while it runs" Classes="label" />
                    <TextBlock Text="The machine starts with room for more, so processors can be added without shutting down (Settings, while it runs). Linux guests use them at once (the guest agent switches them on); Windows desktop editions only after a restart. Off keeps the machine exactly as quickemu would start it." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="HotPlugCpus" Grid.Column="1" IsChecked="{Binding HotPlugCpus}" />
                </Grid>
              </Border>
              <Border Classes="row" IsVisible="{Binding HotPlugCpus}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Up to" Classes="label" />
                    <TextBlock Text="The most processors the machine can have while it runs. Rounded up to whole cores." Classes="help" />
                  </StackPanel>
                  <NumericUpDown x:Name="MaxCores" Grid.Column="1" Value="{Binding MaxCores}" Minimum="1" Maximum="{Binding HostCores}" Increment="1" FormatString="0" Width="150" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Nested virtualization" Classes="label" />
                    <TextBlock Text="Lets the guest run virtual machines of its own (WSL 2, Hyper-V, Docker Desktop, Android emulators, a VM manager inside). Off hides the processor's virtualization feature from the guest. Recommended: as this computer allows." Classes="help" />
                    <TextBlock x:Name="HostNestedNote" Text="{Binding HostNestedNote}" Classes="help" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="Nested" ItemsSource="{Binding NestedChoices}" SelectedItem="{Binding Nested}" HorizontalAlignment="Right" />
                    <Button x:Name="EnableHostNested" Classes="tool" Content="Turn on for this computer" Command="{Binding EnableHostNestedCommand}" IsVisible="{Binding HostNestedOff}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding LiveCpusShown}" Margin="0,8,0,0">
            <TextBlock Text="WHILE IT RUNS" Classes="grouptitle" />
            <Border Grid.Column="1" Classes="badge-now"><TextBlock Text="Applies now" /></Border>
          </Grid>
          <Border x:Name="LiveCpus" Classes="group" IsVisible="{Binding LiveCpusShown}">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Processors it has now" Classes="label" />
                    <TextBlock Text="Raise it to add processors without shutting down. Added processors stay until the machine powers off." Classes="help" />
                    <TextBlock x:Name="LiveCpusStatus" Text="{Binding LiveCpusStatus}" Classes="help" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <NumericUpDown x:Name="LiveCpusValue" Value="{Binding LiveCpus}" Minimum="1" Maximum="{Binding LiveCpusMost}" Increment="1" FormatString="0" Width="150" />
                    <Button x:Name="ApplyLiveCpus" Classes="tool" Content="Add now" Command="{Binding ApplyLiveCpusCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <TextBlock Text="ADVANCED" Classes="grouptitle" />
          <Border Classes="group">
            <Border Classes="row first">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Processor model" Classes="label" />
                  <TextBlock Text="Leave empty: the machine sees this computer's own processor, which is fastest. A named model (e.g. Haswell-v2) is only for systems that need one." Classes="help" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding CpuModel}" PlaceholderText="Automatic" Width="300" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Border>
        </StackPanel>

        <!-- Hard disks -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=disks}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Hard disks" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <Border Classes="row first">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel>
                  <TextBlock Text="Changes at power off" Classes="label" />
                  <TextBlock Text="Recommended: keep them, as a real computer does. Discard starts every power on from the disks as they are now, whatever happens inside (for testing software, or a machine for guests); Ask offers both each time. While changes can be discarded, snapshots and AutoProtect are off: they would go with the changes." Classes="help" />
                </StackPanel>
                <ComboBox x:Name="OnPowerOff" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.PowerOffOptions}" SelectedItem="{Binding OnPowerOff}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Border>
          <ItemsControl ItemsSource="{Binding Disks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiskRow">
                <Border Classes="group">
                  <StackPanel>
                    <Border Classes="row first">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="tile"><Path Classes="icon" Data="{StaticResource IconDisk}" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Used}" Classes="help" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="tool danger" Content="Remove" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveDiskCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Detach the disk from the machine (its file stays on this computer). The first disk holds the system and cannot be removed." />
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Size" Classes="label" />
                          <TextBlock Text="A disk can grow, never shrink. After growing it, extend the partition inside the system (Disk Management on Windows, GParted on Linux)." Classes="help" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <NumericUpDown Value="{Binding SizeGb}" Minimum="{Binding MinimumGb}" Maximum="65536" Increment="8" FormatString="0" Width="150" />
                          <TextBlock Text="GB" VerticalAlignment="Center" Classes="muted" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Connected as" Classes="label" />
                          <TextBlock Text="Changing the system disk's bus can stop the system starting until it has the driver." Classes="help" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.BusOptions}" SelectedItem="{Binding Bus}" />
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Speed limit" Classes="label" VerticalAlignment="Center" />
                            <Border Classes="badge-next" VerticalAlignment="Center"><TextBlock Text="Applies at next power on" /></Border>
                          </StackPanel>
                          <TextBlock Text="Recommended: 0, no limit. A limit keeps a busy machine from slowing this computer's drive for everything else, or shows how a system behaves on a slow disk. Reads and writes count together." Classes="help" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <NumericUpDown x:Name="DiskLimitMBps" Value="{Binding LimitMBps}" Minimum="0" Maximum="100000" Increment="10" FormatString="0" Width="130" />
                          <TextBlock Text="MB/s" VerticalAlignment="Center" Classes="muted" />
                          <NumericUpDown x:Name="DiskLimitIops" Value="{Binding LimitIops}" Minimum="0" Maximum="1000000" Increment="100" FormatString="0" Width="130" />
                          <TextBlock Text="IOPS" VerticalAlignment="Center" Classes="muted" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Compact" Classes="label" VerticalAlignment="Center" />
                            <Border Classes="badge-now" VerticalAlignment="Center"><TextBlock Text="Applies now" /></Border>
                          </StackPanel>
                          <TextBlock Text="Gives this computer back the space the system no longer uses. Only while the machine is off; a disk with snapshots cannot be compacted (they would be lost). For the most back, let the system free its unused space first (Windows does it by itself; on Linux, sudo fstrim -av)." Classes="help" />
                          <TextBlock Text="{Binding CompactStatus}" Classes="help" Margin="0,4,0,0" IsVisible="{Binding CompactStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="tool" Content="Compact" VerticalAlignment="Center" IsEnabled="{Binding !Compacting}"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CompactDiskCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="group">
            <Border Classes="row first">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Add a disk" Classes="label" />
                  <TextBlock Text="A new empty disk; it uses space only as the system fills it." Classes="help" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <NumericUpDown Value="{Binding NewDiskGb}" Minimum="1" Maximum="65536" Increment="8" FormatString="0" Width="150" />
                  <TextBlock Text="GB" VerticalAlignment="Center" Classes="muted" />
                  <Button Classes="tool" Content="Add" Command="{Binding AddDiskCommand}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
          </Border>
        </StackPanel>

        <!-- CD/DVD and floppy -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=media}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="CD/DVD and floppy" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-now"><TextBlock Text="Discs can be changed while it runs" /></Border>
          </Grid>
          <ItemsControl x:Name="MediaList" ItemsSource="{Binding Media}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MediaRow">
                <Border Classes="group">
                  <StackPanel>
                    <Border Classes="row first">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="tile"><Path Classes="icon" Data="{StaticResource IconDisc}" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding FileName, TargetNullValue='Empty'}" Classes="help" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                          <StackPanel x:Name="MediaStatus" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Ellipse Classes="state" Classes.running="{Binding InDrive}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" Classes="help" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="tool" Content="Change disc…" Tag="change" />
                          <Button Classes="tool" Content="Eject" ToolTip.Tip="{Binding EjectTip}" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).EjectCommand}" CommandParameter="{Binding}" />
                          <Button Classes="tool danger" Content="Remove" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveMediaCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Connected" Classes="label" />
                          <TextBlock Text="&quot;Until the system is installed&quot; keeps an installer in the drive only while the disk is empty, so the machine starts from its disk afterwards." Classes="help" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ConnectOptions}" SelectedItem="{Binding Connect}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="tool" Content="Add a CD/DVD drive" Command="{Binding AddDriveCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Network -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=network}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Network" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Connection" Classes="label" />
                    <TextBlock Text="NAT shares this computer's internet and keeps the machine invisible to your network; this computer reaches it through forwarded ports. Bridged puts it on your network like another computer." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding NetModes}" SelectedItem="{Binding NetMode}" />
                </Grid>
              </Border>
              <Border Classes="row" IsVisible="{Binding IsBridged}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Bridge" Classes="label" />
                    <TextBlock Text="A network bridge on this computer (e.g. br0). Bridging needs a one-time setup that the host check explains." Classes="help" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Bridge}" Width="300" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Classes="row" IsVisible="{Binding IsSegment}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Segment name" Classes="label" />
                    <TextBlock Text="Machines with the same name see each other and nothing else, like computers on their own switch. VM Qontrol hands each an address that stays its own; the subnets are in Virtual networks." Classes="help" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Text="{Binding Segment}" Width="220" VerticalAlignment="Center" />
                    <Button Classes="tool" Content="Virtual networks…" Command="{Binding OpenNetworksCommand}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Adapter" Classes="label" />
                    <TextBlock Text="The network card the system sees." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding NicModels}" SelectedItem="{Binding NicModel}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="MAC address" Classes="label" />
                    <TextBlock Text="Leave empty unless your network hands out addresses by MAC." Classes="help" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding Mac}" PlaceholderText="Automatic" Width="230" VerticalAlignment="Center" />
                    <Button Classes="tool" Content="New" Command="{Binding NewMacCommand}" VerticalAlignment="Center" ToolTip.Tip="Make a new random address" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="row" IsVisible="{Binding HasNetwork}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Cable connected at power on" Classes="label" VerticalAlignment="Center" />
                      <Border Classes="badge-next" VerticalAlignment="Center"><TextBlock Text="Applies at next power on" /></Border>
                    </StackPanel>
                    <TextBlock Text="Recommended on. Off starts the machine with its network cable pulled out, as for a system that must not go online before it is set up; ⋯ → Connect the network cable plugs it in while it runs." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="ConnectedAtPowerOn" Grid.Column="1" IsChecked="{Binding ConnectedAtPowerOn}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="REACHING THE MACHINE FROM THIS COMPUTER" Classes="grouptitle" IsVisible="{Binding IsNat}" />
          <Border Classes="group" IsVisible="{Binding IsNat}">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="SSH port" Classes="label" />
                    <TextBlock Text="A port on this computer that reaches the machine's SSH port (22). 0 picks the first free port from 22220." Classes="help" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                    <NumericUpDown Value="{Binding SshPort}" Minimum="0" Maximum="65535" FormatString="0" Width="150" IsEnabled="{Binding SshForward}" />
                    <ToggleSwitch IsChecked="{Binding SshForward}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="row">
                <StackPanel Spacing="10">
                  <StackPanel>
                    <TextBlock Text="Port forwards" Classes="label" />
                    <TextBlock Text="A port on this computer that reaches a port in the machine, e.g. 8080 here to a web server on 80." Classes="help" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Forwards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ForwardRow">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                          <ComboBox SelectedItem="{Binding Protocol}" ItemsSource="{x:Static vm:Text.Protocols}" Width="90" />
                          <TextBlock Text="This computer" VerticalAlignment="Center" Classes="muted" />
                          <NumericUpDown Value="{Binding HostPort}" Minimum="1" Maximum="65535" FormatString="0" Width="120" VerticalContentAlignment="Center" />
                          <TextBlock Text="→  machine" VerticalAlignment="Center" Classes="muted" />
                          <NumericUpDown Value="{Binding GuestPort}" Minimum="1" Maximum="65535" FormatString="0" Width="120" VerticalContentAlignment="Center" />
                          <Button Classes="icononly" Content="✕" ToolTip.Tip="Remove this forward" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveForwardCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="tool" Content="Add a port forward" Command="{Binding AddForwardCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- USB -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=usb}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="USB" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <Border Classes="row first">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Controller" Classes="label" />
                  <TextBlock Text="USB 3 suits every current system; USB 2 is for older ones." Classes="help" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding UsbControllers}" SelectedItem="{Binding UsbController}" />
              </Grid>
            </Border>
          </Border>
          <TextBlock Text="ALWAYS CONNECTED" Classes="grouptitle" />
          <Border Classes="group">
            <StackPanel>
              <ItemsControl x:Name="UsbRules" ItemsSource="{Binding UsbRules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UsbRuleRow">
                    <Border Padding="18,12" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="tile"><Path Classes="icon" Data="{StaticResource IconUsb}" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Id}" Classes="help" FontFamily="monospace" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="tool" Content="Remove" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveUsbRuleCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="18,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28">
                  <TextBlock Classes="help" Margin="0" VerticalAlignment="Center"
                             Text="Devices of these kinds go to the machine at every power on and whenever they are plugged in while it runs. Add one from the machine's USB devices (tick Always connect), or by its id here." />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Text="{Binding NewUsbId}" AutomationProperties.Name="USB device ID (vendor:product)" PlaceholderText="046d:c52b" Width="130" FontFamily="monospace" VerticalAlignment="Center" />
                    <Button Classes="tool" Content="Add" Command="{Binding AddUsbRuleCommand}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Host drives -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=hostdrives}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Host drives" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <TextBlock Classes="help" Margin="0,0,0,4" TextWrapping="Wrap"
                     Text="A disk, a partition or a disc drive of this computer, handed to the machine as a USB drive: every guest has drivers for it. Drives are read-only unless writing was allowed; writing is never offered for a drive this computer is using." />
          <TextBlock Text="CONNECTED AT POWER ON" Classes="grouptitle" />
          <Border Classes="group">
            <StackPanel>
              <ItemsControl x:Name="HostDriveSettings" ItemsSource="{Binding HostDrives}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HostDriveRow">
                    <Border Padding="18,12" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="tile"><Path Classes="icon" Data="{Binding Icon}" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="help" FontFamily="monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="tool" Content="Remove" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveHostDriveCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="18,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28">
                  <TextBlock Classes="help" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="Drives are chosen from the list of this computer's drives, where one can also be connected to the running machine, and writing allowed." />
                  <Button Grid.Column="1" Classes="tool" Content="Choose host drives…" Command="{Binding ChooseHostDrivesCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Sound -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=sound}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Sound" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Sound card" Classes="label" />
                    <TextBlock Text="Sound plays through the viewer window. Automatic picks a card the system has drivers for." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding SoundCards}" SelectedItem="{Binding SoundCard}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Microphone" Classes="label" />
                    <TextBlock Text="Lets programs in the guest record from this computer's microphone, through the viewer while it shows the machine (on by default, for calls). Off, the guest gets a sound card with no input at all." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="Microphone" Grid.Column="1" IsChecked="{Binding Microphone}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Display -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=display}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Display" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Where the screen is shown" Classes="label" />
                    <TextBlock Text="A viewer window brings clipboard sharing, USB redirection and resizing." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayBackends}" SelectedItem="{Binding DisplayBackend}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Viewer program" Classes="label" />
                    <TextBlock Text="The program that opens the screen." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ViewerOptions}" SelectedItem="{Binding Viewer}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Open full screen" Classes="label" />
                    <TextBlock Text="The screen fills your monitor when it opens; with the guest tools the system takes your monitor's resolution. Leave full screen with the viewer's own key (Shift+F11 in remote-viewer)." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="FullScreen" Grid.Column="1" IsChecked="{Binding FullScreen}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Copy and paste" Classes="label" />
                    <TextBlock Text="Text and pictures copied here paste in the machine, and back. Needs the guest tools in the machine (its Summary page puts them in; a Windows machine made with Easy Install has them). Turn it off to keep the machine apart from your desktop (recommended for untrusted software). Applies from the next power on." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="CopyPaste" Grid.Column="1" IsChecked="{Binding CopyPaste}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Drag files in" Classes="label" />
                    <TextBlock Text="Files dropped on the viewer window are copied into the machine (its Downloads folder on Linux, a temporary folder on Windows). Needs the guest tools. Applies from the next power on." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="FileTransfer" Grid.Column="1" IsChecked="{Binding FileTransfer}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Graphics adapter" Classes="label" />
                    <TextBlock Text="Automatic picks the one the system works best with." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayDevices}" SelectedItem="{Binding DisplayDevice}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="3D acceleration" Classes="label" />
                    <TextBlock Text="Speeds up Linux desktops with the VirtIO GPU. Turn it off if the screen stays black or the viewer will not start." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding GlOptions}" SelectedItem="{Binding Gl}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Starting resolution" Classes="label" />
                    <TextBlock Text="0 × 0 = 1280 × 800. With the guest tools the screen follows the viewer window's size anyway." Classes="help" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding Width}" Minimum="0" Maximum="7680" Increment="160" FormatString="0" Width="130" />
                    <TextBlock Text="×" VerticalAlignment="Center" Classes="muted" />
                    <NumericUpDown Value="{Binding Height}" Minimum="0" Maximum="4320" Increment="90" FormatString="0" Width="130" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Monitors" Classes="label" />
                    <TextBlock Text="How many screens the guest sees; the viewer opens a window for each. Works with VirtIO and QXL graphics (the recommended ones), and the guest arranges them in its display settings." Classes="help" />
                  </StackPanel>
                  <NumericUpDown x:Name="Monitors" Grid.Column="1" Value="{Binding Monitors}" Minimum="1" Maximum="4" Increment="1" FormatString="0" Width="130" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Keyboard and mouse -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=input}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Keyboard and mouse" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Keyboard" Classes="label" />
                    <TextBlock Text="Automatic suits every system." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Keyboards}" SelectedItem="{Binding Keyboard}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Pointer" Classes="label" />
                    <TextBlock Text="A tablet pointer follows your mouse exactly, with no capturing; keep it unless an old system needs a mouse." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Pointers}" SelectedItem="{Binding Pointer}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Keyboard layout" Classes="label" />
                    <TextBlock Text="QEMU's layout name (en-us, de, fr, en-gb…). Only some viewers need it; SPICE sends keys as you type them." Classes="help" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Layout}" Width="300" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Firmware and TPM -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=firmware}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Firmware and TPM" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="UEFI firmware" Classes="label" />
                    <TextBlock Text="Modern systems start with UEFI. Changing it on an installed system stops it starting: it was installed for one or the other." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Uefi}" />
                </Grid>
              </Border>
              <Border Classes="row" IsEnabled="{Binding Uefi}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Secure Boot" Classes="label" />
                    <TextBlock Text="Only signed systems start. Windows 11 needs it to install; most Linux works with it; some tools and older systems do not." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SecureBoot}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="TPM 2.0" Classes="label" />
                    <TextBlock Text="A security chip Windows 11 requires; it also keeps BitLocker keys. Its data stays with the machine." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Tpm}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Serial port -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=serial}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Serial port" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <Border Classes="row first">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Serial port" Classes="label" />
                  <TextBlock Text="Linux and BSD print their boot messages and a login prompt on it, shown in the machine's Console tab. Automatic: on for them, off for Windows and macOS." Classes="help" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SerialOptions}" SelectedItem="{Binding Serial}" />
              </Grid>
            </Border>
          </Border>
          <TextBlock Text="THIS COMPUTER'S SERIAL PORTS" Classes="grouptitle" />
          <Border Classes="group">
            <StackPanel>
              <ItemsControl x:Name="HostSerialPorts" ItemsSource="{Binding SerialPorts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SerialPortRow">
                    <Border Padding="18,12" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                        <Border Classes="tile"><Path Classes="icon" Data="{StaticResource IconTerminal}" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="help" FontFamily="monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="tool" Content="Give me access…" Command="{Binding GiveAccessCommand}" IsVisible="{Binding NeedsAccess}" VerticalAlignment="Center"
                                ToolTip.Tip="Adds you to the group that owns serial ports (your password is asked for); it takes effect when you next sign in" />
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding Connected}" AutomationProperties.Name="{Binding Name, StringFormat='Connect {0} at power on'}" OnContent="" OffContent="" VerticalAlignment="Center"
                                      ToolTip.Tip="Hand this port to the machine at power on, as its next COM port" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="18,14">
                <StackPanel Spacing="6">
                  <TextBlock Classes="help" Margin="0" TextWrapping="Wrap" IsVisible="{Binding NoSerialPorts}"
                             Text="This computer has no serial ports the system found." />
                  <TextBlock Classes="help" Margin="0" TextWrapping="Wrap"
                             Text="A port that is switched on becomes the machine's next COM port (COM2 when the console above has COM1). A USB serial adapter can instead be passed whole from USB devices, with the guest's own driver." />
                  <TextBlock x:Name="SerialNote" Text="{Binding SerialNote}" IsVisible="{Binding HasSerialNote}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Performance -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=performance}">
        <StackPanel Spacing="14" DataContext="{Binding Perf}" x:DataType="vm:PerformanceSettingsViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Performance" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <TextBlock Classes="help" Margin="0,0,0,4" TextWrapping="Wrap"
                     Text="For games, audio work and big workloads. Everyday machines need none of this: every setting here is off until you choose it." />
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Gaming and graphics card passthrough" Classes="label" />
                    <TextBlock Text="Sets everything below the way a gaming machine wants it (pinned cores in the largest cache, I/O threads, huge pages, Looking Glass) and says what this computer still needs. The graphics card to hand over stays your choice." Classes="help" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="ApplyGaming" Grid.Column="1" Classes="tool" Content="Set up for gaming" Command="{Binding ApplyGamingCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding GamingChecks}" IsVisible="{Binding HasGamingChecks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckRow">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="96,230,*" ColumnSpacing="12">
                        <Border Classes="pill" Classes.ok="{Binding IsOk}" Classes.warn="{Binding !IsOk}" VerticalAlignment="Top" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Badge}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Top" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="help" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Text="PROCESSORS AND MEMORY" Classes="grouptitle" />
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="Pin processors" Classes="label" />
                    <TextBlock Text="{Binding PinDetail}" Classes="help" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox x:Name="PinChoice" Grid.Column="1" ItemsSource="{Binding PinChoices}" SelectedItem="{Binding Pin}" Width="330" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" IsVisible="{Binding IsCustomPin}">
                    <TextBlock Text="Guest processors on" VerticalAlignment="Center" />
                    <TextBox Text="{Binding CustomCpus}" PlaceholderText="2-5" Width="140" FontFamily="monospace" />
                    <TextBlock Text="QEMU's own threads on" VerticalAlignment="Center" />
                    <TextBox Text="{Binding CustomEmulator}" PlaceholderText="1" Width="100" FontFamily="monospace" />
                    <TextBlock Text="{Binding CustomError}" Foreground="{DynamicResource QDanger}" IsVisible="{Binding HasCustomError}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="An I/O thread for each disk" Classes="label" />
                    <TextBlock Text="Disk work runs on threads of its own instead of the guest processors' (VirtIO disks). Helps when the guest reads and writes a lot; costs nothing otherwise." Classes="help" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="IoThreads" Grid.Column="1" IsChecked="{Binding IoThreads}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="Huge pages" Classes="label" />
                    <TextBlock Text="{Binding PoolText}" Classes="help" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PoolNote}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding PoolNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,4,0,0" />
                  </StackPanel>
                  <ComboBox x:Name="HugePages" Grid.Column="1" ItemsSource="{Binding HugeChoices}" SelectedItem="{Binding HugePages}" Width="330" VerticalAlignment="Center" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="tool" Content="{Binding ReserveText}" Command="{Binding ReserveCommand}" IsVisible="{Binding NeedsPages}" HorizontalAlignment="Right" Margin="0,8,0,0"
                          ToolTip.Tip="Reserves the pages until this computer restarts; your password is asked for" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="LOOKING GLASS" Classes="grouptitle" />
          <Border Classes="group">
            <Border Classes="row first">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Shared memory for Looking Glass" Classes="label" />
                  <TextBlock Text="{Binding LookingGlassText}" Classes="help" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="LookingGlass" Grid.Column="1" IsChecked="{Binding LookingGlass}" />
              </Grid>
            </Border>
          </Border>

          <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,0">
            <TextBlock Text="PCI DEVICES" Classes="grouptitle" Margin="0" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="Show every device" IsChecked="{Binding ShowAllPci}" />
          </Grid>
          <TextBlock Text="{Binding PciSummary}" Classes="help" TextWrapping="Wrap" Margin="0,2,0,6" />
          <Border Classes="group">
            <ItemsControl x:Name="PciRows" ItemsSource="{Binding PciDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PciRow">
                  <Border Padding="18,12" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                      <Border Classes="tile"><Path Classes="icon" Data="{StaticResource IconCpu}" /></Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Classes="help" FontFamily="monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="{DynamicResource QWarning}" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" />
                      </StackPanel>
                      <Border Grid.Column="2" Classes="pill" Classes.ok="{Binding Ready}" Classes.muted="{Binding !Ready}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding State}" />
                      </Border>
                      <CheckBox Grid.Column="3" Content="Hand over" IsChecked="{Binding Chosen}" IsEnabled="{Binding CanChoose}" VerticalAlignment="Center"
                                ToolTip.Tip="Give this device, and the others in its IOMMU group, to the machine at power on" ToolTip.ShowOnDisabled="True" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
        </StackPanel>

        <!-- Boot and devices -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=boot}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Boot and devices" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first" IsEnabled="{Binding !Uefi}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Boot order" Classes="label" />
                    <TextBlock Text="For BIOS machines. A UEFI machine keeps its boot order in its firmware: use Power on to firmware setup (Ctrl+K) to change it there." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding BootOrders}" SelectedItem="{Binding BootOrder}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Boot menu at every power on" Classes="label" />
                    <TextBlock Text="Shows for a few seconds; pick a device to start from with Esc. Power on to firmware setup does the same once." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding BootMenu}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <TextBlock Text="DEVICES" Classes="grouptitle" />
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Random-number generator" Classes="label" />
                    <TextBlock Text="A fast source of randomness for the system's encryption keys; keep it on." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Rng}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Memory ballooning" Classes="label" />
                    <TextBlock Text="Lets the system give unused memory back to this computer. Automatic leaves it on except for older macOS releases." Classes="help" />
                    <CheckBox Content="Automatic" IsChecked="{Binding BalloonAuto}" Margin="0,6,0,0" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Balloon}" IsEnabled="{Binding !BalloonAuto}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Watchdog" Classes="label" />
                    <TextBlock Text="A timer the system must keep resetting; if it hangs, the machine is restarted (or powered off, or paused). Linux and Windows servers can use it." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding WatchdogOptions}" SelectedItem="{Binding Watchdog}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Report crashes (pvpanic)" Classes="label" />
                    <TextBlock Text="The system says when it crashes, so the machine shows Crashed at once instead of looking frozen. Linux supports it; Windows needs the VirtIO drivers." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding CrashReporting}" />
                </Grid>
              </Border>
              <Border x:Name="VsockRow" Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="VirtIO socket (vsock)" Classes="label" />
                    <TextBlock Text="A direct line between this computer and the guest that needs no network: SSH and developer tools reach the guest even with networking off. Linux guests support it; Windows needs the VirtIO drivers." Classes="help" />
                    <TextBlock Text="{Binding VsockNote}" Classes="help" Margin="0,4,0,0" IsVisible="{Binding Vsock}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Vsock}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Shared folders -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=shares}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Shared folders" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="A folder of this computer the machine uses like its own: files saved on either side are there on the other at once. It appears in the machine by itself once the guest tools run there, and again at every start." />
          <TextBlock Classes="help" TextWrapping="Wrap" Text="{Binding SharesStatus}" IsVisible="{Binding SharesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ItemsControl ItemsSource="{Binding Shares}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShareRow">
                <Border Classes="group">
                  <StackPanel>
                    <Border Classes="row first">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="tile"><Path Classes="icon" Data="{StaticResource IconFolder}" /></Border>
                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                        <Button Grid.Column="2" Classes="tool danger" Content="Stop sharing" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveShareCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="Name in the machine" Classes="label" />
                          <TextBlock Text="The tag the system mounts it by (letters, digits and dashes)." Classes="help" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                          <CheckBox Content="Read only" IsChecked="{Binding ReadOnly}" VerticalAlignment="Center" />
                          <TextBox Text="{Binding Tag}" Width="180" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Classes="row">
                      <StackPanel Spacing="6">
                        <TextBlock Text="In the machine" Classes="help" Margin="0" />
                        <SelectableTextBlock Text="{Binding InMachine}" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="AddShare" Classes="tool" Content="Share a folder…" HorizontalAlignment="Left" />
          <Border Classes="group" IsVisible="{Binding IsWindowsGuest}">
            <Border Classes="row first">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{DynamicResource QAccent}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes="help" Margin="0"
                           Text="Windows needs the guest tools from the VirtIO driver disc (Settings, Guest tools). The app then adds WinFsp and the drives by itself; each folder is a drive in This PC named after it." />
              </Grid>
            </Border>
          </Border>
        </StackPanel>

        <!-- AutoProtect -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=autoprotect}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="AutoProtect" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-now"><TextBlock Text="Applies at once" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Take snapshots automatically while the machine runs" Classes="label" />
                    <TextBlock Text="A safety net: if something goes wrong inside the machine, go back to one from the Snapshots tab. Off is recommended unless you want that net; your own snapshots work either way. Snapshots are taken while VM Qontrol is open." Classes="help" />
                  </StackPanel>
                  <ToggleSwitch x:Name="AutoProtectOn" Grid.Column="1" IsChecked="{Binding AutoProtectOn}" />
                </Grid>
              </Border>
              <Border Classes="row" IsEnabled="{Binding AutoProtectOn}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="How often" Classes="label" />
                    <TextBlock Text="Counted from when the machine started. Every hour is recommended; the machine pauses for a moment while each is taken." Classes="help" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding AutoProtectIntervals}" SelectedItem="{Binding AutoProtectInterval}" />
                </Grid>
              </Border>
              <Border Classes="row" IsEnabled="{Binding AutoProtectOn}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="How many to keep" Classes="label" />
                    <TextBlock Text="With more, the oldest automatic one is deleted. 3 is recommended: each holds the disk changes since the one before plus a copy of the memory. Your own snapshots are never deleted." Classes="help" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="1" Value="{Binding AutoProtectKeep}" Minimum="1" Maximum="50" Increment="1" FormatString="0" Width="150" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Advanced -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=advanced}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Advanced" Classes="h1" />
            <Border Grid.Column="1" Classes="badge-next"><TextBlock Text="Applies at next power on" /></Border>
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <Border Classes="row first">
                <StackPanel Spacing="8">
                  <StackPanel>
                    <TextBlock Text="Extra QEMU arguments" Classes="label" />
                    <TextBlock Text="Added at the end of the command, one per line. For anything this window does not offer; a wrong argument stops the machine starting, and the reason is shown." Classes="help" />
                  </StackPanel>
                  <TextBox Text="{Binding ExtraArgs}" AcceptsReturn="True" MinHeight="80" FontFamily="monospace" PlaceholderText="-device&#x0a;intel-iommu" />
                </StackPanel>
              </Border>
              <Border Classes="row">
                <StackPanel Spacing="8">
                  <TextBlock Text="The command this machine starts with" Classes="label" />
                  <Border Classes="code">
                    <SelectableTextBlock Text="{Binding CommandPreview}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Change history -->
        <StackPanel Classes="section" IsVisible="{Binding SectionKey, Converter={x:Static vm:Text.Equal}, ConverterParameter=history}">
          <TextBlock Text="Change history" Classes="h1" />
          <TextBlock Text="Every saved change, newest first. Restore puts the settings back as they were before that change." Classes="muted" TextWrapping="Wrap" />
          <Border Classes="group" IsVisible="{Binding !HasHistory}">
            <Border Padding="18,22">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Classes="tile" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconHistory}" /></Border>
                <TextBlock Text="No changes saved yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Each time you save, what changed is listed here and can be put back." Classes="help" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Border>
          <Border Classes="group" IsVisible="{Binding HasHistory}">
            <ItemsControl x:Name="History" ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:SettingsChange">
                  <Border Padding="18,14" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <Border Classes="tile" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconHistory}" /></Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding At, StringFormat='{}{0:g}'}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Changes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="help" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="tool" Content="Restore" VerticalAlignment="Top"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Panel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
