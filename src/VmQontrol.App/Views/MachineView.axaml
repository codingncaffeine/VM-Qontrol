<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VmQontrol.App.ViewModels"
             xmlns:ctl="using:VmQontrol.App.Controls"
             x:Class="VmQontrol.App.Views.MachineView"
             x:DataType="vm:MachineViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource QPagePadding}" Spacing="20">
      <!-- Header: who the machine is and what it is doing. -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="badge" Classes.windows="{Binding FamilyWindows}" Classes.linux="{Binding FamilyLinux}" Classes.apple="{Binding FamilyApple}" Classes.bsd="{Binding FamilyBsd}"
                Width="52" Height="52" CornerRadius="14" VerticalAlignment="Top">
          <TextBlock Text="{Binding Badge}" FontSize="20" />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6">
          <TextBlock x:Name="MachineName" Text="{Binding Name}" Classes="hero" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="pill" Classes.ok="{Binding IsRunning}" Classes.warn="{Binding IsPaused}" Classes.muted="{Binding IsOff}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="state" Classes.running="{Binding IsRunning}" Classes.paused="{Binding IsPaused}" VerticalAlignment="Center" />
                <TextBlock x:Name="StateText" Text="{Binding StateText}" />
              </StackPanel>
            </Border>
            <Border x:Name="RecordingPill" Classes="pill bad" IsVisible="{Binding IsRecording}" VerticalAlignment="Center" Padding="8,2,4,2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource QDanger}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding RecordingText}" VerticalAlignment="Center" />
                <Button x:Name="StopRecording" Classes="icononly" Command="{Binding StopRecordingCommand}" Padding="4,1" ToolTip.Tip="Stop recording and save the video">
                  <Path Classes="icon" Data="{StaticResource IconStop}" Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource QDanger}" StrokeThickness="0" />
                </Button>
              </StackPanel>
            </Border>
            <Border x:Name="DiscardPill" Classes="pill" IsVisible="{Binding DiscardsChanges}" VerticalAlignment="Center"
                    ToolTip.Tip="This machine's changes are thrown away at power off (or it asks); Settings → Hard disks changes that">
              <TextBlock Text="Changes are not kept" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="CablePill" Classes="pill warn" IsVisible="{Binding CableOut}" VerticalAlignment="Center" Padding="8,2,4,2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Cable out" VerticalAlignment="Center" />
                <Button x:Name="PlugCable" Classes="icononly" Command="{Binding SetCableCommand}" Padding="4,1" ToolTip.Tip="Connect the network cable" AutomationProperties.Name="Connect the network cable">
                  <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
                  <Path Classes="icon" Data="{StaticResource IconNetwork}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
              </StackPanel>
            </Border>
            <Border x:Name="CapturePill" Classes="pill" IsVisible="{Binding IsCapturing}" VerticalAlignment="Center" Padding="8,2,4,2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource QAccent}" VerticalAlignment="Center" />
                <TextBlock Text="Capturing traffic" VerticalAlignment="Center" />
                <Button x:Name="StopCapture" Classes="icononly" Command="{Binding StopCaptureCommand}" Padding="4,1" ToolTip.Tip="Stop capturing and finish the .pcap file" AutomationProperties.Name="Stop capturing network traffic">
                  <Path Classes="icon" Data="{StaticResource IconStop}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
              </StackPanel>
            </Border>
            <Button x:Name="GuestToolsPill" Classes="icononly" Padding="0" VerticalAlignment="Center" Command="{Binding ShowGuestToolsCommand}" IsVisible="{Binding GuestToolsMissing}"
                    ToolTip.Tip="Copy and paste with this computer needs the guest tools: this shows how to put them in" AutomationProperties.Name="Guest tools not installed">
              <Border Classes="pill warn" Padding="8,2">
                <TextBlock Text="Guest tools not installed" VerticalAlignment="Center" />
              </Border>
            </Button>
            <TextBlock Text="{Binding GuestLabel}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="·" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding KindLabel}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Classes="icononly" VerticalAlignment="Top" Command="{Binding ToggleFavoriteCommand}"
                ToolTip.Tip="Favorites are listed first in the library">
          <Path Classes="icon" Data="{StaticResource IconStar}" Classes.favorite="{Binding IsFavorite}" />
        </Button>
      </Grid>

      <!-- Power and actions: only what makes sense in the current state is shown. -->
      <!-- Power on the left, the machine's tools on the right; Reset lives in More, as Workstation keeps it under Power. -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <Button x:Name="NewFromTemplate" Classes="primary" Command="{Binding CloneCommand}" IsVisible="{Binding IsTemplate}"
                ToolTip.Tip="Make a new machine that starts exactly as this template is">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="+" FontWeight="SemiBold" />
            <TextBlock Text="New machine from this template" />
          </StackPanel>
        </Button>
        <Button x:Name="PowerOn" Classes="primary" Command="{Binding PowerOnCommand}" IsVisible="{Binding CanPowerOn}" IsEnabled="{Binding !Busy}"
                ToolTip.Tip="{Binding PowerOnTip}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="iconfill" Data="{StaticResource IconPlay}" Fill="{DynamicResource QOnAccent}" />
            <TextBlock Text="{Binding PowerOnText}" />
          </StackPanel>
        </Button>
        <Button x:Name="OpenScreen" Classes="primary" Command="{Binding OpenScreenCommand}" IsVisible="{Binding IsActive}"
                ToolTip.Tip="Open the machine's screen in a viewer window (Enter). In it, Ctrl+Alt gives the mouse and keyboard back to this computer.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconScreen}" Stroke="{DynamicResource QOnAccent}" />
            <TextBlock Text="Open screen" />
          </StackPanel>
        </Button>
        <Button x:Name="ShutDown" Classes="tool" Command="{Binding ShutDownCommand}" IsVisible="{Binding IsRunning}"
                ToolTip.Tip="Ask the guest to close its programs and turn itself off, like pressing a computer's power button (Ctrl+E)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconPower}" />
            <TextBlock Text="Shut down" />
          </StackPanel>
        </Button>
        <Button x:Name="Pause" Classes="tool" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}"
                ToolTip.Tip="Freeze the machine where it is; Resume carries on exactly there (Ctrl+Shift+P)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="iconfill" Data="{StaticResource IconPause}" />
            <TextBlock Text="Pause" />
          </StackPanel>
        </Button>
        <Button x:Name="Resume" Classes="tool" Command="{Binding ResumeCommand}" IsVisible="{Binding IsPaused}" ToolTip.Tip="Carry on from where the machine was paused (Ctrl+Shift+P)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="iconfill" Data="{StaticResource IconPlay}" />
            <TextBlock Text="Resume" />
          </StackPanel>
        </Button>
        <Button x:Name="Suspend" Classes="tool" Command="{Binding SuspendCommand}" IsVisible="{Binding IsActive}"
                ToolTip.Tip="Save everything the machine is doing and turn it off; Resume carries on from there, programs and all (Ctrl+Z)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconSuspend}" />
            <TextBlock Text="Suspend" />
          </StackPanel>
        </Button>
        <Button x:Name="PowerOff" Classes="tool danger" Command="{Binding PowerOffCommand}" IsVisible="{Binding IsActive}"
                ToolTip.Tip="Turn off at once, like pulling the plug (unsaved work is lost) (Ctrl+Shift+E)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="iconfill" Data="{StaticResource IconStop}" Fill="{DynamicResource QDanger}" />
            <TextBlock Text="Power off" />
          </StackPanel>
        </Button>
      </WrapPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Stretch">
        <!-- A menu of the devices plugged in, as a viewer's USB menu: tick one to hand it over, untick to give it back. -->
        <Button x:Name="OpenUsb" Classes="tool" ToolTip.Tip="Hand USB devices plugged into this computer to the machine (Ctrl+U)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconUsb}" />
            <TextBlock Text="USB devices" />
            <Path Classes="icon" Data="M7,10 L12,15 L17,10" Width="12" Height="12" Stretch="Uniform" Opacity="0.7" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" />
          </Button.Flyout>
        </Button>
        <Button x:Name="OpenSettings" Classes="tool" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Memory, processors, disks, discs, network, display and everything else (Ctrl+D)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconSettings}" />
            <TextBlock Text="Settings" />
          </StackPanel>
        </Button>
        <Button x:Name="More" Classes="tool" ToolTip.Tip="More: reset, clone, template, firmware setup, the machine's folder…" MinWidth="40">
          <TextBlock Text="⋯" FontWeight="Bold" HorizontalAlignment="Center" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Reset" InputGesture="Ctrl+R" Command="{Binding ResetCommand}" IsVisible="{Binding IsActive}" ToolTip.Tip="Restart at once, like a computer's reset button (unsaved work is lost)" />
              <MenuItem x:Name="PowerOnBackground" Header="Power on in the background" InputGesture="Ctrl+Shift+B" Command="{Binding PowerOnInBackgroundCommand}" IsVisible="{Binding CanPowerOn}" ToolTip.Tip="Start without opening the screen; Open screen shows it whenever you want" />
              <MenuItem Header="Power on to firmware setup" Command="{Binding PowerOnToFirmwareCommand}" IsVisible="{Binding CanOpenFirmware}" />
              <MenuItem Header="Discard suspended state…" Command="{Binding DiscardSuspendedCommand}" IsVisible="{Binding CanDiscardSuspended}" />
              <MenuItem x:Name="OpenDrivesItem" Header="Host drives…" Command="{Binding OpenDrivesCommand}" ToolTip.Tip="Hand a disk, a partition or a disc drive of this computer to the machine" />
              <MenuItem Header="Send Ctrl+Alt+Del" InputGesture="Ctrl+Alt+Insert" Command="{Binding SendCtrlAltDelCommand}" IsVisible="{Binding IsActive}" />
              <MenuItem x:Name="SendKeyMenu" Header="Send a key combination" IsVisible="{Binding IsActive}"
                        ToolTip.Tip="Keys this computer keeps for itself when typed (switching consoles, the screenshot key), sent to the machine instead">
                <MenuItem Header="Ctrl+Alt+Backspace" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+backspace" />
                <MenuItem Header="Print Screen" Command="{Binding SendKeysCommand}" CommandParameter="print" />
                <MenuItem Header="Alt+Tab" Command="{Binding SendKeysCommand}" CommandParameter="alt+tab" />
                <MenuItem Header="Super (Windows key)" Command="{Binding SendKeysCommand}" CommandParameter="meta_l" />
                <MenuItem Header="Switch the guest's console">
                  <MenuItem Header="Ctrl+Alt+F1" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f1" />
                  <MenuItem Header="Ctrl+Alt+F2" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f2" />
                  <MenuItem Header="Ctrl+Alt+F3" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f3" />
                  <MenuItem Header="Ctrl+Alt+F4" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f4" />
                  <MenuItem Header="Ctrl+Alt+F5" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f5" />
                  <MenuItem Header="Ctrl+Alt+F6" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f6" />
                  <MenuItem Header="Ctrl+Alt+F7" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f7" />
                  <MenuItem Header="Ctrl+Alt+F8" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f8" />
                  <MenuItem Header="Ctrl+Alt+F9" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f9" />
                  <MenuItem Header="Ctrl+Alt+F10" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f10" />
                  <MenuItem Header="Ctrl+Alt+F11" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f11" />
                  <MenuItem Header="Ctrl+Alt+F12" Command="{Binding SendKeysCommand}" CommandParameter="ctrl+alt+f12" />
                </MenuItem>
              </MenuItem>
              <MenuItem x:Name="DisconnectCableItem" Header="Disconnect the network cable" Command="{Binding SetCableCommand}" IsVisible="{Binding CanDisconnectCable}"
                        ToolTip.Tip="Pull the machine's network cable out while it runs; the system sees its network go away">
                <MenuItem.CommandParameter><x:Boolean>False</x:Boolean></MenuItem.CommandParameter>
              </MenuItem>
              <MenuItem x:Name="ConnectCableItem" Header="Connect the network cable" Command="{Binding SetCableCommand}" IsVisible="{Binding CanConnectCable}"
                        ToolTip.Tip="Plug the machine's network cable back in">
                <MenuItem.CommandParameter><x:Boolean>True</x:Boolean></MenuItem.CommandParameter>
              </MenuItem>
              <MenuItem x:Name="CaptureItem" Header="Capture network traffic" Command="{Binding StartCaptureCommand}" IsVisible="{Binding CanCapture}"
                        ToolTip.Tip="Write every packet the machine sends and receives to a .pcap file in its folder, for Wireshark; stop from the mark beside its state" />
              <MenuItem Header="Save a screenshot" InputGesture="Ctrl+Shift+S" Command="{Binding SaveScreenshotCommand}" IsVisible="{Binding IsActive}" />
              <MenuItem x:Name="RecordScreenItem" Header="Record the screen" Command="{Binding StartRecordingCommand}" IsVisible="{Binding CanRecord}"
                        ToolTip.Tip="Record what the machine shows into a video in your Videos folder (no sound); stop from the red mark beside its state" />
              <MenuItem Header="Clone…" Command="{Binding CloneCommand}" IsVisible="{Binding !IsTemplate}" />
              <MenuItem Header="Make into a template…" Command="{Binding MakeTemplateCommand}" IsVisible="{Binding CanMakeTemplate}" />
              <MenuItem Header="Turn back into a machine" Command="{Binding UndoTemplateCommand}" IsVisible="{Binding IsTemplate}" />
              <MenuItem x:Name="ExportMenu" Header="Export">
                <MenuItem x:Name="ExportFolder" Header="As a folder…" ToolTip.Tip="A portable copy of the machine (disks, firmware, TPM, history) with a checksum of every file; the machine must be off" />
                <MenuItem x:Name="ExportTar" Header="As one file (.tar)…" ToolTip.Tip="The same portable copy in one file, to move or back up; Import a machine brings it back" />
                <MenuItem Header="As a quickemu .conf" Command="{Binding ExportQuickemuCommand}" ToolTip.Tip="A .conf beside the machine's folder that runs this disk with quickemu" />
              </MenuItem>
              <MenuItem x:Name="MoveTo" Header="Move to…" IsVisible="{Binding !IsQuickemu}"
                        ToolTip.Tip="Moves the machine's folder to another folder or drive (the machine must be off); a linked machine keeps its shared disk" />
              <MenuItem Header="Show in file manager" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open the machine's files (its disks and settings) in the file manager" />
              <MenuItem x:Name="OpenDiskItem" Header="Open its disk here" Command="{Binding OpenDiskCommand}" IsVisible="{Binding CanOpenDisk}"
                        ToolTip.Tip="Look inside the machine's disk in the file manager, read-only, to copy files out (the machine must be off)" />
              <MenuItem Header="Open its disk here for changes…" Command="{Binding OpenDiskForChangesCommand}" IsVisible="{Binding CanOpenDiskForChanges}"
                        ToolTip.Tip="Open the machine's disk so files can be added, changed or deleted on it (the machine must be off)" />
              <MenuItem Header="Copy the QEMU command line" Command="{Binding CopyCommandLineCommand}" />
              <MenuItem Header="{Binding IsFavorite, Converter={x:Static vm:Text.FavoriteToggle}}" Command="{Binding ToggleFavoriteCommand}" />
              <Separator />
              <MenuItem Header="Delete…" InputGesture="Delete" Command="{Binding DeleteMachineCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      </Grid>

      <!-- A disk open on this computer (D37): where, and closing it so the machine can start. -->
      <Border x:Name="OpenDiskCard" Classes="card" IsVisible="{Binding HasOpenDisk}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="DISK OPEN ON THIS COMPUTER" Classes="section" />
            <SelectableTextBlock Text="{Binding OpenDiskText}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Classes="tool" Content="Show" Command="{Binding ShowOpenDiskCommand}" ToolTip.Tip="Open the disk's files in the file manager" />
            <Button x:Name="CloseDisk" Classes="primary" Content="Close" Command="{Binding CloseDiskCommand}" IsEnabled="{Binding !ChangingDisk}"
                    ToolTip.Tip="Write out any changes and close the disk, so the machine can start" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- The machine's notes (written in Settings). -->
      <Border Classes="card" IsVisible="{Binding HasNotes}">
        <StackPanel Spacing="6">
          <TextBlock Text="NOTES" Classes="section" />
          <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Anything that stops the machine starting, in plain words. -->
      <Border x:Name="Problems" Classes="card problem" IsVisible="{Binding HasProblems}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconWarning}" Stroke="{DynamicResource QWarning}" />
            <TextBlock Text="This machine cannot start yet" FontWeight="SemiBold" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="muted" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TabControl x:Name="Tabs" SelectedIndex="{Binding Tab}" Padding="0,14,0,0">
        <TabItem Header="Summary">
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="20">
            <!-- The screen, refreshed every two seconds while the machine runs. -->
            <StackPanel Spacing="12">
              <!-- Easy Install: what it is doing, until the guest itself says it finished (InstallSignal). -->
              <Border x:Name="InstallCard" Classes="card install" Classes.done="{Binding InstallFinished}" IsVisible="{Binding ShowInstallCard}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <Path Classes="badgeicon" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,0,0"
                        Data="{StaticResource IconDisc}" IsVisible="{Binding !InstallFinished}" />
                  <Path Classes="badgeicon" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,0,0"
                        Data="{StaticResource IconCheck}" IsVisible="{Binding InstallFinished}" />
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Name="InstallTitle" Text="{Binding InstallTitle}" FontSize="{DynamicResource QFontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="InstallBody" Text="{Binding InstallBody}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LeanNote}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" IsVisible="{Binding ShowLeanNote}" />
                    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding InstallWorking}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasInstallTime}">
                      <Path Classes="icon" Data="{StaticResource IconClock}" Width="12" Height="12" />
                      <TextBlock x:Name="InstallTime" Text="{Binding InstallTime}" Classes="muted" FontSize="{DynamicResource QFontSmall}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="8">
                    <Button x:Name="InstallPowerOn" Classes="primary" Command="{Binding PowerOnCommand}" IsVisible="{Binding InstallNotStarted}" IsEnabled="{Binding !Busy}" Content="Power on and install" />
                    <Button Classes="primary" Command="{Binding PowerOnCommand}" IsVisible="{Binding InstallWaiting}" IsEnabled="{Binding !Busy}" Content="Power on and carry on" />
                    <Button x:Name="InstallGotIt" Classes="tool" Command="{Binding AcknowledgeInstallCommand}" IsVisible="{Binding InstallFinished}" Content="Got it" />
                    <Button x:Name="SetUpEasyInstall" Classes="primary" Command="{Binding SetUpEasyInstallCommand}" IsVisible="{Binding ShowEasyInstallOffer}" Content="Set up Easy Install…" />
                    <Button Classes="tool" Command="{Binding DismissEasyInstallOfferCommand}" IsVisible="{Binding ShowEasyInstallOffer}" Content="I will install it myself" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Background="{DynamicResource QScreen}" CornerRadius="{DynamicResource QRadiusLarge}" ClipToBounds="True"
                      BorderBrush="{DynamicResource QBorder}" BorderThickness="1">
                <Grid>
                  <Viewbox Stretch="Uniform" MinHeight="240">
                    <Panel Width="1280" Height="800">
                      <Image x:Name="Screen" Source="{Binding Screen}" Stretch="Uniform" IsVisible="{Binding HasScreen}" />
                    </Panel>
                  </Viewbox>
                  <TextBlock Text="{Binding ScreenPlaceholder}" IsVisible="{Binding !HasScreen}" Classes="muted"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Classes="card" IsVisible="{Binding IsActive}">
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Address" Classes="muted" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding GuestAddressText}" Classes.warn="{Binding GuestToolsMissing}" />
                  <TextBlock Grid.Row="1" Text="SSH" Classes="muted" IsVisible="{Binding SshCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8" IsVisible="{Binding SshCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <SelectableTextBlock Text="{Binding SshCommand}" FontFamily="monospace" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="OpenSsh" Classes="tool" Command="{Binding OpenSshCommand}" ToolTip.Tip="Open a terminal signed in to the machine over SSH (through its forwarded port)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Path Classes="icon" Data="{StaticResource IconTerminal}" />
                          <TextBlock Text="Open in terminal" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tool" Command="{Binding CopySshCommand}" ToolTip.Tip="Copy the command">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Path Classes="icon" Data="{StaticResource IconCopy}" />
                          <TextBlock Text="Copy" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Guest tools: whether the agent answers, and the exact steps to install them. -->
              <Border x:Name="GuestToolsCard" Classes="card">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Classes="state" Classes.running="{Binding GuestToolsOk}" Classes.paused="{Binding GuestToolsWarn}" VerticalAlignment="Center" />
                      <TextBlock Text="GUEST TOOLS" Classes="section" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="GuestToolsHow" Grid.Column="1" Classes.tool="{Binding !GuestToolsPrimary}" Classes.primary="{Binding GuestToolsPrimary}" Command="{Binding ToggleGuestToolsStepsCommand}"
                            Content="{Binding GuestToolsStepsButton}" />
                  </Grid>
                  <TextBlock x:Name="GuestToolsStatusText" Text="{Binding GuestToolsStatus}" TextWrapping="Wrap" Classes.warn="{Binding GuestToolsMissing}" />
                  <StackPanel x:Name="GuestToolsSteps" Spacing="10" IsVisible="{Binding ShowGuestToolsSteps}">
                    <TextBlock Text="{Binding GuestToolsAdvice.Summary}" Classes="help" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding GuestToolsAdvice.Steps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="18,*" Margin="0,3">
                            <TextBlock Text="›" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="code" IsVisible="{Binding GuestToolsAdvice.Command, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <SelectableTextBlock x:Name="GuestToolsCommand" Text="{Binding GuestToolsAdvice.Command}" FontFamily="monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="tool" Command="{Binding CopyGuestToolsCommandCommand}" ToolTip.Tip="Copy the command, to paste in the machine's terminal" VerticalAlignment="Top">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Data="{StaticResource IconCopy}" />
                            <TextBlock Text="Copy" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding GuestToolsAdvice.AfterSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="18,*" Margin="0,3">
                            <TextBlock Text="›" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="8" IsVisible="{Binding GuestToolsAdvice.NeedsDriversDisc}">
                      <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding !Shell.GuestToolsBusy}">
                        <Button x:Name="InsertDriversDisc" Classes="primary" Command="{Binding InsertGuestToolsCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource IconDisc}" />
                            <TextBlock Text="Insert the guest tools" IsVisible="{Binding Shell.HasGuestTools}" />
                            <TextBlock Text="Download and insert the guest tools" IsVisible="{Binding !Shell.HasGuestTools}" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="ChooseDriversDisc" Classes="tool" Content="Use my own disc image…" ToolTip.Tip="A virtio-win.iso you already have" />
                      </WrapPanel>
                      <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" IsVisible="{Binding !Shell.HasGuestTools}"
                                 Text="{Binding Shell.GuestToolsSize, StringFormat='VM Qontrol downloads the VirtIO driver disc once ({0}, from the virtio-win project, checked before use) and uses it for every machine.'}" />
                      <!-- The download, while it runs (shared by every page that asked for it). -->
                      <Grid x:Name="GuestToolsDownload" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding Shell.GuestToolsBusy}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Shell.GuestToolsStatus}" Classes="muted" FontSize="{DynamicResource QFontSmall}" />
                          <ProgressBar Value="{Binding Shell.GuestToolsPercent}" IsIndeterminate="{Binding !Shell.GuestToolsSizeKnown}" Maximum="100" Height="4" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="tool" Content="Stop" Command="{Binding Shell.CancelGuestToolsCommand}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- The hardware, in words. -->
            <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="HARDWARE" Classes="section" />
                <ItemsControl x:Name="Details" ItemsSource="{Binding Details}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailRow">
                      <Grid ColumnDefinitions="110,*" Margin="0,4">
                        <TextBlock Text="{Binding Label}" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="code" Margin="0,6,0,0">
                  <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" FontSize="12" />
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- Snapshots: take one at any moment, go back to any of them. -->
        <TabItem x:Name="SnapshotsTab" Header="Snapshots">
          <StackPanel Spacing="14" DataContext="{Binding Snapshots}" x:DataType="vm:SnapshotsViewModel">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Take a snapshot" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="A snapshot keeps this moment so you can come back to it: before an update, before trying something risky. Taken while the machine runs, it keeps the open programs too." />
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                  <TextBox x:Name="SnapshotName" Text="{Binding NewName}" PlaceholderText="Name">
                    <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding TakeCommand}" /></TextBox.KeyBindings>
                  </TextBox>
                  <TextBox Grid.Column="1" Text="{Binding NewDescription}" PlaceholderText="What is special about this moment (optional)" />
                  <Button x:Name="TakeSnapshot" Grid.Column="2" Classes="primary" Content="Take snapshot" Command="{Binding TakeCommand}" />
                </Grid>
                <TextBlock x:Name="SnapshotNote" Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="No snapshots yet." Classes="muted" IsVisible="{Binding IsEmpty}" />
            <ItemsControl x:Name="SnapshotTree" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SnapshotRow">
                  <Border Classes="card" Margin="{Binding Indent}" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <Border Width="128" Height="80" CornerRadius="6" Background="{DynamicResource QScreen}" ClipToBounds="True">
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <Border Classes="pill ok" IsVisible="{Binding IsCurrent}"><TextBlock Text="You are here" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding When}" Classes="muted" FontSize="{DynamicResource QFontSmall}" />
                        <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="{DynamicResource QFontSmall}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="tool" Content="Go back to this" Command="{Binding $parent[ItemsControl].((vm:SnapshotsViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}" />
                        <Button Classes="tool danger" Content="Delete" Command="{Binding $parent[ItemsControl].((vm:SnapshotsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>

        <!-- The last minute, sampled once a second while this tab is open. -->
        <TabItem x:Name="PerformanceTab" Header="Performance">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16" DataContext="{Binding Performance}" x:DataType="vm:PerformanceViewModel">
            <TextBlock Grid.ColumnSpan="2" Classes="muted" Margin="0,0,0,-4" TextWrapping="Wrap"
                       IsVisible="{Binding $parent[UserControl].((vm:MachineViewModel)DataContext).IsOff}"
                       Text="Performance is measured while the machine runs." />
            <Border Classes="card" Grid.Row="1">
              <StackPanel Spacing="4">
                <TextBlock Text="PROCESSOR" Classes="section" />
                <TextBlock x:Name="CpuValue" Text="{Binding CpuText}" Classes="hero" />
                <TextBlock Text="Share of the processors given to the machine" Classes="muted" FontSize="{DynamicResource QFontSmall}" />
                <ctl:LiveChart Height="120" Margin="0,8,0,0" Series1="{Binding CpuSeries}" Maximum="100" Format="{Binding PercentFormat}"
                               Series1Brush="{DynamicResource QSeries1}" GridBrush="{DynamicResource QGrid}" TextBrush="{DynamicResource QTextMuted}" SurfaceBrush="{DynamicResource QSurface}" />
              </StackPanel>
            </Border>
            <Border Classes="card" Grid.Row="1" Grid.Column="1">
              <StackPanel Spacing="4">
                <TextBlock Text="MEMORY" Classes="section" />
                <TextBlock Text="{Binding MemoryText}" Classes="hero" />
                <TextBlock Text="Host memory the machine is using now" Classes="muted" FontSize="{DynamicResource QFontSmall}" />
                <ctl:LiveChart Height="120" Margin="0,8,0,0" Series1="{Binding MemorySeries}" Maximum="{Binding MemoryMaximum}" Format="{Binding BytesFormat}"
                               Series1Brush="{DynamicResource QSeries1}" GridBrush="{DynamicResource QGrid}" TextBrush="{DynamicResource QTextMuted}" SurfaceBrush="{DynamicResource QSurface}" />
              </StackPanel>
            </Border>
            <Border Classes="card" Grid.Row="2">
              <StackPanel Spacing="4">
                <TextBlock Text="DISK" Classes="section" />
                <TextBlock Text="{Binding DiskText}" FontSize="{DynamicResource QFontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="3" CornerRadius="2" Background="{DynamicResource QSeries1}" VerticalAlignment="Center" /><TextBlock Text="Read" Classes="muted" FontSize="{DynamicResource QFontSmall}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="3" CornerRadius="2" Background="{DynamicResource QSeries2}" VerticalAlignment="Center" /><TextBlock Text="Written" Classes="muted" FontSize="{DynamicResource QFontSmall}" /></StackPanel>
                </StackPanel>
                <ctl:LiveChart Height="120" Margin="0,8,0,0" Series1="{Binding ReadSeries}" Series2="{Binding WriteSeries}" Series1Name="Read" Series2Name="Written" Format="{Binding RateFormat}"
                               Series1Brush="{DynamicResource QSeries1}" Series2Brush="{DynamicResource QSeries2}" GridBrush="{DynamicResource QGrid}" TextBrush="{DynamicResource QTextMuted}" SurfaceBrush="{DynamicResource QSurface}" />
              </StackPanel>
            </Border>
            <Border Classes="card" Grid.Row="2" Grid.Column="1">
              <StackPanel Spacing="4">
                <TextBlock Text="NETWORK" Classes="section" />
                <TextBlock Text="{Binding NetText}" FontSize="{DynamicResource QFontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding NetAvailable}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="3" CornerRadius="2" Background="{DynamicResource QSeries1}" VerticalAlignment="Center" /><TextBlock Text="In" Classes="muted" FontSize="{DynamicResource QFontSmall}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="3" CornerRadius="2" Background="{DynamicResource QSeries2}" VerticalAlignment="Center" /><TextBlock Text="Out" Classes="muted" FontSize="{DynamicResource QFontSmall}" /></StackPanel>
                </StackPanel>
                <TextBlock IsVisible="{Binding !NetAvailable}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}"
                           Text="Network traffic is reported by the guest tools (qemu-guest-agent on Linux, the virtio-win guest tools on Windows)." />
                <ctl:LiveChart Height="120" Margin="0,8,0,0" Series1="{Binding InSeries}" Series2="{Binding OutSeries}" Series1Name="In" Series2Name="Out" Format="{Binding RateFormat}" IsVisible="{Binding NetAvailable}"
                               Series1Brush="{DynamicResource QSeries1}" Series2Brush="{DynamicResource QSeries2}" GridBrush="{DynamicResource QGrid}" TextBrush="{DynamicResource QTextMuted}" SurfaceBrush="{DynamicResource QSurface}" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- The serial port, as text. -->
        <TabItem x:Name="ConsoleTab" Header="Console">
          <DockPanel DataContext="{Binding Console}" x:DataType="vm:ConsoleViewModel">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="tool" Command="{Binding CopyAllCommand}" ToolTip.Tip="Copy everything the console shows">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource IconCopy}" />
                  <TextBlock Text="Copy all" />
                </StackPanel>
              </Button>
            </Grid>
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsEnabled="{Binding Connected}">
              <TextBox x:Name="ConsoleInput" Text="{Binding Input}" FontFamily="monospace" PlaceholderText="Type a line and press Enter">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Classes="secondary" Content="Send" Margin="8,0,0,0" Command="{Binding SendCommand}" />
            </Grid>
            <Border Background="{DynamicResource QScreen}" CornerRadius="{DynamicResource QRadius}" Padding="12,8" Height="440">
              <ListBox x:Name="ConsoleLines" ItemsSource="{Binding Lines}" Classes="console" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="13" Foreground="#D6DEEA" TextWrapping="NoWrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </DockPanel>
        </TabItem>

        <TabItem x:Name="LogTab" Header="Log">
          <DockPanel DataContext="{Binding Logs}" x:DataType="vm:LogViewModel">
            <Button DockPanel.Dock="Top" Classes="tool" HorizontalAlignment="Left" Command="{Binding LoadCommand}" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                <TextBlock Text="Reload" />
              </StackPanel>
            </Button>
            <Border Classes="code" Padding="12" MinHeight="360">
              <SelectableTextBlock Text="{Binding Text}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
            </Border>
          </DockPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
