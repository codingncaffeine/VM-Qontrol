<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VmQontrol.App.ViewModels"
        xmlns:views="using:VmQontrol.App.Views"
        x:Class="VmQontrol.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="VM Qontrol"
        Icon="avares://vmqontrol/Assets/icon-256.png"
        Width="1320" Height="860" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </Window.KeyBindings>
  <Panel>
    <DockPanel>
      <!-- Status bar: the last thing that happened. -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource QSidebar}" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,1,0,0" Padding="16,6">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
          <TextBlock x:Name="StatusLine" Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource QFontSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <!-- While a viewer (not ours) can hold a machine's mouse: how to get it back. -->
          <StackPanel x:Name="MouseHintBar" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      IsVisible="{Binding MouseHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Border Classes="pill" VerticalAlignment="Center"><TextBlock Text="Ctrl+Alt" FontFamily="monospace" FontSize="{DynamicResource QFontSmall}" /></Border>
            <TextBlock x:Name="MouseHintText" Text="{Binding MouseHint}" FontSize="{DynamicResource QFontSmall}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- While paste cannot work in a machine on screen: what it needs, and a click to the steps. -->
          <Button x:Name="ClipboardHintBar" Grid.Column="2" Classes="icononly" Padding="0" VerticalAlignment="Center" Command="{Binding ShowClipboardMachineCommand}"
                  IsVisible="{Binding ClipboardHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="Show how to put the guest tools in" AutomationProperties.Name="Copy and paste needs the guest tools">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="pill warn" VerticalAlignment="Center"><TextBlock Text="Copy and paste" FontSize="{DynamicResource QFontSmall}" /></Border>
              <TextBlock x:Name="ClipboardHintText" Text="{Binding ClipboardHint}" FontSize="{DynamicResource QFontSmall}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="3" Text="Ctrl+K  all commands" Classes="muted" FontSize="{DynamicResource QFontSmall}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="280,*">
        <!-- Library sidebar. -->
        <Border Background="{DynamicResource QSidebar}" BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,1,0">
          <DockPanel Margin="14,16">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
              <Button Classes="icononly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding ShowHomeCommand}" ToolTip.Tip="The welcome page and the host check">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Image Source="avares://vmqontrol/Assets/logo-64.png" Width="34" Height="34" />
                  <TextBlock Text="VM Qontrol" Classes="h1" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="OpenPreferences" Grid.Column="1" Classes="icononly" VerticalAlignment="Center" Command="{Binding OpenPreferencesCommand}" ToolTip.Tip="Preferences">
                <Path Classes="icon" Data="{StaticResource IconSettings}" Width="16" Height="16" />
              </Button>
            </Grid>
            <Button x:Name="NewMachine" DockPanel.Dock="Top" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding NewMachineCommand}" Margin="0,0,0,12" ToolTip.Tip="Create a virtual machine, step by step">
              <TextBlock Text="+  New machine" />
            </Button>
            <TextBox x:Name="Search" AutomationProperties.Name="Search machines" DockPanel.Dock="Top" Classes="search" PlaceholderText="Search machines   (Ctrl+F)"
                     Text="{Binding Search}" Margin="0,0,0,16" />
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,6">
              <TextBlock Text="LIBRARY" Classes="section" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icononly" Command="{Binding RefreshCommand}" ToolTip.Tip="Look for machines again (F5)">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
              </Button>
            </Grid>
            <TextBlock x:Name="LibraryEmpty" DockPanel.Dock="Top" Text="No machines yet." Classes="muted" Margin="4,0" TextWrapping="Wrap"
                       IsVisible="{Binding LibraryEmpty}" />
            <ListBox x:Name="Library" AutomationProperties.Name="Machines" Classes="library" ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SidebarSelection}">
              <ListBox.DataTemplates>
                <DataTemplate x:DataType="vm:FolderHeading">
                  <TextBlock Text="{Binding Header}" Classes="section" Margin="2,10,0,0" IsHitTestVisible="False" />
                </DataTemplate>
                <DataTemplate x:DataType="vm:MachineViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Move to folder…" Command="{Binding MoveToFolderCommand}" />
                        <MenuItem Header="Remove from folder" Command="{Binding RemoveFromFolderCommand}" IsVisible="{Binding HasFolder}" />
                        <MenuItem x:Name="FolderPowerOn" Header="{Binding FolderPowerOnText}" Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).PowerOnFolderCommand}" CommandParameter="{Binding FolderName}" IsVisible="{Binding HasFolder}"
                                  ToolTip.Tip="Power on every machine in this folder that is off, without opening their screens" />
                        <MenuItem x:Name="FolderShutDown" Header="{Binding FolderShutDownText}" Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).ShutDownFolderCommand}" CommandParameter="{Binding FolderName}" IsVisible="{Binding HasFolder}"
                                  ToolTip.Tip="Ask every running machine in this folder to shut down, as its power button would" />
                        <MenuItem Header="{Binding IsFavorite, Converter={x:Static vm:Text.FavoriteToggle}}" Command="{Binding ToggleFavoriteCommand}" />
                        <Separator />
                        <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="Copy command line" Command="{Binding CopyCommandLineCommand}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Border Classes="badge" Classes.windows="{Binding FamilyWindows}" Classes.linux="{Binding FamilyLinux}" Classes.apple="{Binding FamilyApple}" Classes.bsd="{Binding FamilyBsd}"
                            Width="34" Height="34">
                      <TextBlock Text="{Binding Badge}" FontSize="13" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding LibraryLabel}" Classes="muted" FontSize="{DynamicResource QFontSmall}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Path Classes="iconfill" Data="{StaticResource IconStar}" Width="11" Height="11" Fill="{DynamicResource QWarning}" IsVisible="{Binding IsFavorite}" />
                      <Ellipse Classes="state" Classes.running="{Binding IsRunning}" Classes.paused="{Binding IsPaused}" ToolTip.Tip="{Binding StateText}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- The page: welcome, or the selected machine. -->
        <Panel Grid.Column="1">
          <views:WelcomeView x:Name="Welcome" IsVisible="{Binding ShowWelcome}" />
          <ContentControl x:Name="SettingsPage" Content="{Binding SettingsPage}" IsVisible="{Binding ShowSettings}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:SettingsViewModel">
                <views:SettingsView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl x:Name="WizardPage" Content="{Binding Wizard}" IsVisible="{Binding ShowWizard}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:NewMachineViewModel">
                <views:NewMachineView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl x:Name="PreferencesPage" Content="{Binding PreferencesPage}" IsVisible="{Binding ShowPreferences}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:PreferencesViewModel">
                <views:PreferencesView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl x:Name="ImportPage" Content="{Binding ImportPage}" IsVisible="{Binding ShowImport}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ImportViewModel">
                <views:ImportView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <ContentControl x:Name="MachinePage" Content="{Binding Selected}" IsVisible="{Binding ShowMachine}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:MachineViewModel">
                <views:MachineView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>
      </Grid>
    </DockPanel>

    <!-- A question with a typed answer (clone, delete). -->
    <Panel x:Name="PromptLayer" IsVisible="{Binding Prompt, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource QScrim}">
      <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18"
              DataContext="{Binding Prompt}" x:DataType="vm:PromptViewModel" BoxShadow="0 12 40 0 #60000000">
        <StackPanel Spacing="12">
          <TextBlock x:Name="PromptTitle" Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String"><SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="PromptOptions" ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PromptOption">
                <RadioButton GroupName="PromptChoice" IsChecked="{Binding Chosen}" Margin="0,2">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Field}" FontWeight="SemiBold" />
          <TextBox x:Name="PromptText" Text="{Binding Text}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Text="{Binding Progress}" Classes="muted" IsVisible="{Binding Busy}" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="4" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !Busy}" />
            <Button x:Name="PromptConfirm" Classes="primary" Classes.danger="{Binding IsDanger}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- USB devices for one machine. -->
    <Panel x:Name="UsbLayer" IsVisible="{Binding UsbPanel, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource QScrim}">
      <Border Classes="card" Width="780" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20"
              DataContext="{Binding UsbPanel}" x:DataType="vm:UsbPanelViewModel" BoxShadow="0 12 40 0 #60000000">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Title}" Classes="h1" />
              <Button Grid.Column="1" Classes="icononly" Command="{Binding RefreshCommand}" ToolTip.Tip="Look again (after plugging something in)">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding Explain}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
            <TextBlock x:Name="UsbNote" Text="{Binding Note}" TextWrapping="Wrap" />
            <Button Classes="secondary" Content="Done" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
          </StackPanel>
          <ScrollViewer Padding="0,0,14,0">
            <StackPanel Spacing="10">
              <Border Background="{DynamicResource QSurfaceRaised}" BorderBrush="{DynamicResource QBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" IsVisible="{Binding HasLocked}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Path Classes="icon" Data="{StaticResource IconWarning}" Stroke="{DynamicResource QWarning}" Width="18" Height="18" VerticalAlignment="Center" />
                  <TextBlock x:Name="UsbLockedNote" Grid.Column="1" Text="{Binding LockedText}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="muted" />
                </Grid>
              </Border>
              <ItemsControl x:Name="UsbDevices" ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UsbRow">
                    <Border BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="14">
                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource QAccentSoft}" VerticalAlignment="Center">
                          <Path Classes="icon" Data="{StaticResource IconUsb}" Stroke="{DynamicResource QAccent}" Width="18" Height="18" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontFamily="monospace" FontSize="{DynamicResource QFontSmall}" />
                          <TextBlock Text="{Binding Advice}" IsVisible="{Binding HasAdvice}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" Margin="0,2,0,0" />
                          <Button Classes="tool" Content="Offer it again when plugged in" Command="{Binding OfferAgainCommand}" IsVisible="{Binding NeverAsk}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                  ToolTip.Tip="You chose Don't ask about this device; this brings the question back" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill" Classes.ok="{Binding InMachine}" Classes.warn="{Binding IsLocked}" Classes.muted="{Binding IsHere}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StateText}" />
                        </Border>
                        <CheckBox Grid.Column="3" Content="Always connect" IsChecked="{Binding Automatic}" VerticalAlignment="Center"
                                  ToolTip.Tip="Connect this device to the machine at every power on, and whenever it is plugged in while the machine runs" />
                        <Panel Grid.Column="4" Width="96" VerticalAlignment="Center">
                          <Button Classes="tool" Content="{Binding ActionText}" Command="{Binding ToggleCommand}" IsVisible="{Binding CanMove}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <Button Classes="tool" Content="Set up…" Command="{Binding AllowCommand}" IsVisible="{Binding ShowAllow}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  ToolTip.Tip="This computer needs spice-gtk's USB helper to hand devices to machines" />
                        </Panel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- Host drives for one machine. -->
    <Panel x:Name="DrivesLayer" IsVisible="{Binding DrivesPanel, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource QScrim}">
      <Border Classes="card" Width="900" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20"
              DataContext="{Binding DrivesPanel}" x:DataType="vm:DrivesPanelViewModel" BoxShadow="0 12 40 0 #60000000">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Title}" Classes="h1" />
              <Button Grid.Column="1" Classes="icononly" Command="{Binding RefreshCommand}" ToolTip.Tip="Look again (after plugging a drive in or inserting a disc)">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </Grid>
            <TextBlock Text="{Binding Explain}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
            <TextBlock x:Name="DrivesNote" Text="{Binding Note}" TextWrapping="Wrap" />
            <Button Classes="secondary" Content="Done" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
          </StackPanel>
          <ScrollViewer Padding="0,0,14,0">
            <StackPanel Spacing="10">
              <ItemsControl x:Name="HostDriveRows" ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DriveRow">
                    <Border BorderBrush="{DynamicResource QBorder}" BorderThickness="0,0,0,1" Padding="0,12">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14" Margin="{Binding Indent}">
                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource QAccentSoft}" VerticalAlignment="Center" IsVisible="{Binding !IsPartition}">
                          <Path Classes="icon" Data="{Binding Icon}" Stroke="{DynamicResource QAccent}" Width="18" Height="18" Stretch="Uniform" />
                        </Border>
                        <Border Width="36" Height="36" VerticalAlignment="Center" IsVisible="{Binding IsPartition}">
                          <Path Classes="icon" Data="M8,4 L8,14 L18,14" Stroke="{DynamicResource QTextMuted}" Width="14" Height="14" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontFamily="monospace" FontSize="{DynamicResource QFontSmall}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill" Classes.ok="{Binding InMachine}" Classes.warn="{Binding IsBusyHere}" Classes.muted="{Binding IsHere}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StateText}" />
                        </Border>
                        <CheckBox Grid.Column="3" Content="Writable" IsChecked="{Binding Writable}" IsEnabled="{Binding CanWrite}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding WriteTip}" ToolTip.ShowOnDisabled="True" />
                        <CheckBox Grid.Column="4" Content="Always connect" IsChecked="{Binding Automatic}" VerticalAlignment="Center"
                                  ToolTip.Tip="Connect this drive to the machine at every power on (it is left out, with a note, when it is not plugged in)" />
                        <Panel Grid.Column="5" Width="96" VerticalAlignment="Center">
                          <Button Classes="tool" Content="{Binding ActionText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanMove}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Panel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- The virtual network editor. -->
    <Panel x:Name="NetworksLayer" IsVisible="{Binding Networks, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource QScrim}">
      <Border Classes="card" Width="900" MaxHeight="780" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20"
              DataContext="{Binding Networks}" x:DataType="vm:NetworksViewModel" BoxShadow="0 12 40 0 #60000000">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Virtual networks" Classes="h1" />
              <Button Grid.Column="1" Classes="icononly" Command="{Binding RefreshCommand}" ToolTip.Tip="Look again (addresses given out since this opened)">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
              </Button>
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="The networks machines are put on. Changes apply at each machine's next power on." />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
            <TextBlock x:Name="NetworksNote" Text="{Binding Note}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="secondary" Content="Close" Command="{Binding CloseCommand}" />
              <Button x:Name="NetworksSave" Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Padding="0,0,14,0">
            <StackPanel Spacing="10">
              <TextBlock Text="PRIVATE SEGMENTS" Classes="section" />
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoSegments}"
                         Text="No segment yet. Put a machine on one in its Settings, Network, Private segment, or add one here." />
              <ItemsControl x:Name="SegmentRows" ItemsSource="{Binding Segments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SegmentRow">
                    <Border Background="{DynamicResource QSurfaceRaised}" BorderBrush="{DynamicResource QBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                          <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource QAccentSoft}" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconNetwork}" Stroke="{DynamicResource QAccent}" Width="18" Height="18" Stretch="Uniform" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MachinesText}" Classes="muted" FontSize="{DynamicResource QFontSmall}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="pill" Classes.ok="{Binding Serving}" Classes.muted="{Binding !Serving}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                          <Button Grid.Column="3" Classes="tool" Content="Remove" IsVisible="{Binding CanRemove}" VerticalAlignment="Center"
                                  Command="{Binding $parent[ItemsControl].((vm:NetworksViewModel)DataContext).RemoveSegmentCommand}" CommandParameter="{Binding}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Subnet" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ServerText}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" />
                            <TextBlock Text="{Binding SubnetError}" Foreground="{DynamicResource QDanger}" IsVisible="{Binding HasSubnetError}" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Text="{Binding Subnet}" PlaceholderText="{Binding DefaultSubnet}" Width="170" FontFamily="monospace" VerticalAlignment="Center"
                                   ToolTip.Tip="Empty = the subnet its name gives, the same on every computer" />
                          <CheckBox Grid.Column="2" Content="Hand out addresses" IsChecked="{Binding Dhcp}" VerticalAlignment="Center"
                                    ToolTip.Tip="Off for a segment whose machines are set up by hand, or that runs its own DHCP server" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Leases}" IsVisible="{Binding HasLeases}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LeaseRow">
                              <Grid ColumnDefinitions="140,170,*" Margin="50,2,0,2">
                                <TextBlock Text="{Binding Address}" FontFamily="monospace" />
                                <TextBlock Grid.Column="1" Text="{Binding Mac}" FontFamily="monospace" Classes="muted" />
                                <TextBlock Grid.Column="2" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="A new segment, to choose in machines' settings:" />
                <TextBox Grid.Column="1" Text="{Binding NewSegment}" PlaceholderText="lab" Width="170" VerticalAlignment="Center">
                  <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddSegmentCommand}" /></TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2" Classes="tool" Content="Add" Command="{Binding AddSegmentCommand}" VerticalAlignment="Center" />
              </Grid>

              <TextBlock Text="NAT" Classes="section" Margin="0,14,0,0" />
              <Border Background="{DynamicResource QSurfaceRaised}" BorderBrush="{DynamicResource QBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Network inside machines" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NatText}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource QFontSmall}"
                               Text="Each machine has its own; change it only when a network the guest must reach uses the same addresses (an office VPN on 10.0.2.x)." />
                    <TextBlock Text="{Binding NatError}" Foreground="{DynamicResource QDanger}" IsVisible="{Binding HasNatError}" FontSize="{DynamicResource QFontSmall}" />
                  </StackPanel>
                  <TextBox x:Name="NatSubnet" Grid.Column="1" Text="{Binding NatSubnet}" PlaceholderText="10.0.2.0/24" Width="170" FontFamily="monospace" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <TextBlock Text="BRIDGES ON THIS COMPUTER" Classes="section" Margin="0,14,0,0" />
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoBridges}"
                         Text="This computer has no network bridge, so machines cannot join your network directly yet; NAT shares its connection instead. The host check says how to set one up." />
              <ItemsControl ItemsSource="{Binding Bridges}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BridgeRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                      <TextBlock Text="{Binding Name}" FontFamily="monospace" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="pill" Classes.ok="{Binding Ok}" Classes.warn="{Binding !Ok}"><TextBlock Text="{Binding StateText}" /></Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- Move to folder: a name, or one of the folders that exist. -->
    <Panel x:Name="FolderLayer" IsVisible="{Binding FolderPrompt, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource QScrim}">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18"
              DataContext="{Binding FolderPrompt}" x:DataType="vm:FolderPromptViewModel" BoxShadow="0 12 40 0 #60000000">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" />
          <TextBlock Text="Folders group machines in the library. Type a new folder's name, or pick one below." Classes="muted" TextWrapping="Wrap" />
          <TextBox x:Name="FolderName" Text="{Binding Name}" PlaceholderText="Folder name, e.g. Work or Testing">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding MoveCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ItemsControl ItemsSource="{Binding Existing}" IsVisible="{Binding HasExisting}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="tool" Content="{Binding}" Command="{Binding $parent[ItemsControl].((vm:FolderPromptViewModel)DataContext).PickCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button x:Name="FolderMove" Classes="primary" Content="Move" Command="{Binding MoveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Ctrl+K: every action in one search box. -->
    <Panel x:Name="PaletteLayer" IsVisible="{Binding Palette.IsOpen}" Background="{DynamicResource QScrim}">
      <Border Classes="card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0" Padding="10"
              DataContext="{Binding Palette}" x:DataType="vm:PaletteViewModel" BoxShadow="0 12 40 0 #60000000">
        <StackPanel Spacing="8">
          <TextBox x:Name="PaletteQuery" Classes="search" Text="{Binding Query}" PlaceholderText="Type a command or a machine name" />
          <ListBox x:Name="PaletteList" Classes="library" ItemsSource="{Binding Items}" SelectedItem="{Binding Highlighted}" MaxHeight="380">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Grid.Column="1" Text="{Binding Context}" Classes="muted" FontSize="{DynamicResource QFontSmall}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Enter runs it · ↑↓ choose · Esc closes" Classes="muted" FontSize="{DynamicResource QFontSmall}" Margin="6,0" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- A notice over the window: errors with their reasons, and questions that need an answer. -->
    <Panel x:Name="NoticeLayer" IsVisible="{Binding HasNotice}" Background="{DynamicResource QScrim}">
      <Border Classes="card" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" DataContext="{Binding Notice}"
              x:DataType="vm:NoticeViewModel" BoxShadow="0 12 40 0 #60000000">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource QAccentSoft}" IsVisible="{Binding HasIcon}" VerticalAlignment="Center">
              <Path Classes="icon" Data="{Binding Icon}" Stroke="{DynamicResource QAccent}" Width="20" Height="20" Stretch="Uniform" />
            </Border>
            <Path Classes="icon" Data="{StaticResource IconWarning}" Stroke="{DynamicResource QDanger}" IsVisible="{Binding IsError}" Width="20" Height="20" />
            <TextBlock x:Name="NoticeTitle" Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="{DynamicResource QBackground}" BorderBrush="{DynamicResource QBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" IsVisible="{Binding HasItem}">
            <StackPanel Spacing="3">
              <TextBlock x:Name="NoticeItem" Text="{Binding ItemTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding ItemDetail}" Classes="muted" FontFamily="monospace" FontSize="{DynamicResource QFontSmall}" />
            </StackPanel>
          </Border>
          <Border Classes="code" IsVisible="{Binding HasCode}">
            <SelectableTextBlock Text="{Binding Code}" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
          </Border>
          <CheckBox x:Name="NoticeCheck" Content="{Binding CheckText}" IsChecked="{Binding Checked}" IsVisible="{Binding HasCheck}" />
          <Button x:Name="NoticeAside" Classes="tool" Content="{Binding AsideText}" Command="{Binding AsideCommand}" IsVisible="{Binding HasAside}" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="NoticeDismiss" Classes="secondary" Content="{Binding DismissText}" Command="{Binding DismissCommand}" />
            <Button x:Name="NoticeConfirm" Classes="primary" Classes.danger="{Binding IsDanger}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding HasConfirm}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
