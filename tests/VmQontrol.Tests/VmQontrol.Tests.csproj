<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 builds its own app host. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>VmQontrol.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VmQontrol.Core\VmQontrol.Core.csproj" />
    <ProjectReference Include="..\..\src\VmQontrol.Cli\VmQontrol.Cli.csproj" />
    <ProjectReference Include="..\..\src\VmQontrol.App\VmQontrol.App.csproj" />
  </ItemGroup>

</Project>
