-name
windows-server,process=windows-server,debug-threads=on
-machine
q35,hpet=off,smm=on,vmport=off,accel=kvm
-global
kvm-pit.lost_tick_policy=discard
-global
ICH9-LPC.disable_s3=1
-cpu
host,+hypervisor,+invtsc,l3-cache=on,migratable=no,hv_passthrough,topoext
-smp
cores=8,threads=2,sockets=1
-m
16G
-device
virtio-balloon
-pidfile
windows-server/windows-server.pid
-rtc
base=localtime,clock=host,driftfix=slew
-vga
none
-device
qxl-vga,xres=1280,yres=800,ram_size=65536,vram_size=65536,vgamem_mb=64
-display
egl-headless,rendernode=/dev/dri/renderD128
-spice
disable-ticketing=on,unix=on,addr=windows-server/windows-server.sock
-device
virtio-serial-pci
-chardev
socket,id=agent0,path=windows-server/windows-server-agent.sock,server=on,wait=off
-device
virtserialport,chardev=agent0,name=org.qemu.guest_agent.0
-chardev
spicevmc,id=vdagent0,name=vdagent
-device
virtserialport,chardev=vdagent0,name=com.redhat.spice.0
-chardev
spiceport,id=webdav0,name=org.spice-space.webdav.0
-device
virtserialport,chardev=webdav0,name=org.spice-space.webdav.0
-device
virtio-rng-pci,rng=rng0
-object
rng-random,id=rng0,filename=/dev/urandom
-device
qemu-xhci,id=spicepass
-chardev
spicevmc,id=usbredirchardev1,name=usbredir
-device
usb-redir,chardev=usbredirchardev1,id=usbredirdev1
-chardev
spicevmc,id=usbredirchardev2,name=usbredir
-device
usb-redir,chardev=usbredirchardev2,id=usbredirdev2
-chardev
spicevmc,id=usbredirchardev3,name=usbredir
-device
usb-redir,chardev=usbredirchardev3,id=usbredirdev3
-device
pci-ohci,id=smartpass
-device
usb-ccid
-chardev
spicevmc,id=ccid,name=smartcard
-device
ccid-card-passthru,chardev=ccid
-device
usb-ehci,id=input
-device
usb-kbd,bus=input.0
-k
en-us
-device
usb-tablet,bus=input.0
-audiodev
spice,id=audio0
-device
intel-hda
-device
hda-micro,audiodev=audio0
-device
e1000,netdev=nic
-netdev
user,hostname=windows-server,hostfwd=tcp::22220-:22,id=nic
-global
driver=cfi.pflash01,property=secure,value=on
-drive
if=pflash,format=raw,unit=0,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd,readonly=on
-drive
if=pflash,format=raw,unit=1,file=windows-server/OVMF_VARS.fd
-drive
media=cdrom,index=0,file=windows-server/server.iso
-drive
media=cdrom,index=1,file=windows-server/virtio-win.iso
-device
ide-hd,drive=SystemDisk
-drive
id=SystemDisk,if=none,format=qcow2,file=windows-server/disk.qcow2,discard=unmap,detect-zeroes=unmap,cache=writeback,aio=threads
-chardev
socket,id=chrtpm,path=windows-server/windows-server.swtpm-sock
-tpmdev
emulator,id=tpm0,chardev=chrtpm
-device
tpm-tis,tpmdev=tpm0
-monitor
unix:windows-server/windows-server-monitor.socket,server,nowait
-serial
none
