-name
linux-legacy,process=linux-legacy,debug-threads=on
-machine
pc,smm=off,vmport=off,accel=kvm
-global
kvm-pit.lost_tick_policy=discard
-cpu
host,topoext
-smp
cores=8,threads=2,sockets=1
-m
16G
-device
virtio-balloon
-pidfile
linux-legacy/linux-legacy.pid
-rtc
base=utc,clock=host
-vga
none
-device
virtio-gpu-gl,xres=1280,yres=800
-display
egl-headless,rendernode=/dev/dri/renderD128
-spice
disable-ticketing=on,unix=on,addr=linux-legacy/linux-legacy.sock
-device
virtio-serial-pci
-chardev
socket,id=agent0,path=linux-legacy/linux-legacy-agent.sock,server=on,wait=off
-device
virtserialport,chardev=agent0,name=org.qemu.guest_agent.0
-chardev
spicevmc,id=vdagent0,name=vdagent
-device
virtserialport,chardev=vdagent0,name=com.redhat.spice.0
-chardev
spiceport,id=webdav0,name=org.spice-space.webdav.0
-device
virtserialport,chardev=webdav0,name=org.spice-space.webdav.0
-device
virtio-rng-pci,rng=rng0
-object
rng-random,id=rng0,filename=/dev/urandom
-device
qemu-xhci,id=spicepass
-chardev
spicevmc,id=usbredirchardev1,name=usbredir
-device
usb-redir,chardev=usbredirchardev1,id=usbredirdev1
-chardev
spicevmc,id=usbredirchardev2,name=usbredir
-device
usb-redir,chardev=usbredirchardev2,id=usbredirdev2
-chardev
spicevmc,id=usbredirchardev3,name=usbredir
-device
usb-redir,chardev=usbredirchardev3,id=usbredirdev3
-device
pci-ohci,id=smartpass
-device
usb-ccid
-chardev
spicevmc,id=ccid,name=smartcard
-device
ccid-card-passthru,chardev=ccid
-device
usb-ehci,id=input
-device
usb-kbd,bus=input.0
-k
en-us
-device
usb-tablet,bus=input.0
-audiodev
spice,id=audio0
-device
intel-hda
-device
hda-micro,audiodev=audio0
-device
virtio-net-pci,netdev=nic
-netdev
user,hostname=linux-legacy,hostfwd=tcp::22220-:22,id=nic
-drive
media=cdrom,index=0,file=linux-legacy/install.iso
-device
virtio-blk-pci,drive=SystemDisk
-drive
id=SystemDisk,if=none,format=qcow2,file=linux-legacy/disk.qcow2,discard=unmap,detect-zeroes=unmap,cache=writeback,aio=threads
-monitor
unix:linux-legacy/linux-legacy-monitor.socket,server,nowait
-serial
unix:linux-legacy/linux-legacy-serial.socket,server,nowait
