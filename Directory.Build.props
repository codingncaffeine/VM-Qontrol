<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Real cultures stay on so the interface can be translated; every parser passes CultureInfo.InvariantCulture itself. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Known-vulnerable dependencies, transitive ones included, fail the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Unused usings fail the build (IDE0005), which needs the documentation file; undocumented members are allowed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>VM Qontrol</Product>
    <Company>VM Qontrol</Company>
    <Authors>codingncaffeine</Authors>
    <Copyright>Copyright (C) 2026 VM Qontrol contributors</Copyright>
    <VersionPrefix>0.0.5</VersionPrefix>
  </PropertyGroup>

  <!-- VM Qontrol runs QEMU/KVM and is Linux-only (glibc and musl): Unix-only APIs need no per-call guards. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Central package versions: bump here and nowhere else. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <TmdsDBusVersion>0.94.1</TmdsDBusVersion>
    <MvvmToolkitVersion>8.4.2</MvvmToolkitVersion>
    <TestSdkVersion>18.10.1</TestSdkVersion>
    <XunitVersion>3.2.2</XunitVersion>
    <XunitRunnerVersion>3.1.5</XunitRunnerVersion>
  </PropertyGroup>

</Project>
